<UserControl
    x:Class="NeoEditor.Plugins.DataViewer.Views.PeekPanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dv="clr-namespace:NeoEditor.Plugins.DataViewer.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    x:DataType="dv:PeekPanelViewModel"
    mc:Ignorable="d">
    <Design.DataContext>
        <dv:PeekPanelViewModel />
    </Design.DataContext>

    <DockPanel>
        <!-- Breadcrumb navigation -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Breadcrumbs}" Margin="4,4,4,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="dv:PeekBreadcrumb">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Padding="2,1" FontSize="9"
                                Content="{Binding DisplayText}"
                                Command="{Binding DataContext.NavigateBreadcrumbCommand, ElementName=Root}"
                                CommandParameter="{Binding}" />
                        <TextBlock Text="→" FontSize="9" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Action buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    Spacing="4" Margin="4" HorizontalAlignment="Center">
            <Button Padding="6,4" FontSize="10"
                    Command="{Binding TogglePinCommand}">
                <TextBlock Text="{Binding Loc[EP.Pin]}" />
            </Button>
            <Button Padding="6,4" FontSize="10"
                    Command="{Binding OpenFullCommand}">
                <TextBlock Text="{Binding Loc[EP.OpenFull]}" />
            </Button>
            <Button Padding="6,4" FontSize="10"
                    Command="{Binding OpenInSplitViewCommand}">
                <TextBlock Text="{Binding Loc[EP.SplitView]}" />
            </Button>
        </StackPanel>

        <!-- Content area -->
        <Grid>
            <!-- Empty state -->
            <TextBlock IsVisible="{Binding IsEmpty}"
                       Text="{Binding InfoText}"
                       Foreground="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="12" />

            <!-- Peek content: Overview visualization -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding IsEmpty, Converter={x:Static BoolConverters.Not}}">
                <ContentControl Name="PeekContentHost" Margin="4" />
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
