<Application
    x:Class="NeoEditor.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
    xmlns:game="clr-namespace:NeoEditor.Data.Model.Game"
    xmlns:io="clr-namespace:System.IO;assembly=System.Runtime"
    xmlns:local="using:NeoEditor"
    xmlns:vm="clr-namespace:NeoEditor.ViewModels"
    RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <DataTemplate DataType="io:FileInfo">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <avalonia:SymbolIcon IconVariant="Regular" Symbol="Document" />
                <TextBlock Text="{Binding Name}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="io:DirectoryInfo">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <avalonia:SymbolIcon IconVariant="Regular" Symbol="Folder" />
                <TextBlock Text="{Binding Name}" />
            </StackPanel>
        </DataTemplate>
        <!--  默认选项，根据ViewModel查找View，位置放最后，以免覆盖其他特定的模板  -->
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    </Application.Styles>
</Application>