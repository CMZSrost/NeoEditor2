<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mainContent="clr-namespace:NeoEditor.ViewModels.MainContent">
    <!--  Add Resources Here  -->
    <DataTemplate x:Key="PlainTextDocumentTemplate" DataType="mainContent:PlainTextDocument">
        <StackPanel>
            <TextBlock Text="{Binding Title}" />
            <TextBlock Text="{Binding Content}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>