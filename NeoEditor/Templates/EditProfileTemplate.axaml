<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dragDropHandler="clr-namespace:NeoEditor.Helper.DragDropHandler"
    xmlns:viewModels="clr-namespace:NeoEditor.ViewModels">
    <!--  Add Resources Here  -->
    <dragDropHandler:ModEntryDropHandler x:Key="DataGridDropHandler" x:Shared="True" />
    <DataTemplate x:Key="EditProfileTemplate" DataType="{x:Type viewModels:EditProfileViewModel}">
        <Grid
            Margin="10"
            ColumnDefinitions="*,4,*"
            RowDefinitions="Auto,*">
            <StackPanel Grid.RowSpan="2">
                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="4"
                    RowDefinitions="Auto,Auto,Auto,Auto,*"
                    RowSpacing="4">
                    <Label
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="{Binding Loc[Name]}" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Text="{Binding ProfileInfo.Name}" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="{Binding Loc[Path]}" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="{Binding ProfileInfo.Path}" />
                    <Label
                        Grid.Row="2"
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="{Binding Loc[Description]}" />
                    <TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Text="{Binding ProfileInfo.Description}" />
                    <Label
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="{Binding Loc[Content]}" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Text="{Binding ProfileInfo.Content}" />
                </Grid>
            </StackPanel>
            <GridSplitter
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="1" />
            <StackPanel
                Grid.Row="0"
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="6">
                <Button
                    Margin="5,0"
                    Command="{Binding AddCommand}"
                    Content="{Binding Loc[Add]}" />
                <Button
                    Margin="5,0"
                    Command="{Binding DeleteCommand}"
                    Content="{Binding Loc[Delete]}" />
                <Button
                    Margin="5,0"
                    Command="{Binding MoveUpCommand}"
                    Content="{Binding Loc[MoveUp]}" />
                <Button
                    Margin="5,0"
                    Command="{Binding MoveDownCommand}"
                    Content="{Binding Loc[MoveDown]}" />
                <Button
                    Width="80"
                    Margin="5,0"
                    Command="{Binding SaveCommand}"
                    Content="{Binding Loc[Save]}" />
            </StackPanel>
            <DataGrid
                Grid.Row="1"
                Grid.Column="2"
                AutoGenerateColumns="False"
                CanUserReorderColumns="False"
                Classes="DragAndDrop ItemDragAndDrop"
                ItemsSource="{Binding Entries}"
                SelectedItem="{Binding SelectedEntry}">
                <Interaction.Behaviors>
                    <ContextDropBehavior Handler="{StaticResource DataGridDropHandler}" />
                    <EventTriggerBehavior EventName="LoadingRow">
                        <InvokeCommandAction Command="{Binding EntriesLoadingRowCommand}" PassEventArgsToCommand="True" />
                    </EventTriggerBehavior>
                </Interaction.Behaviors>
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Type}"
                        Header="{Binding Loc[Type]}" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Name}"
                        Header="{Binding Loc[Name]}" />
                    <DataGridTextColumn
                        Width="2*"
                        Binding="{Binding Path}"
                        Header="{Binding Loc[Path]}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DataTemplate>
    <!--  Design  -->
    <Design.PreviewWith>
        <Border
            Width="800"
            Height="500"
            Background="White">
            <ContentControl>
                <ContentControl.DataTemplates>
                    <StaticResource ResourceKey="EditProfileTemplate" />
                </ContentControl.DataTemplates>
                <viewModels:EditProfileViewModel />
            </ContentControl>
        </Border>
    </Design.PreviewWith>
</ResourceDictionary>