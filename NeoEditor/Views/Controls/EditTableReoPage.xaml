<UserControl
    x:Class="NeoEditor.Views.Controls.EditTableReoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:NeoEditor.ViewModels.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reoGrid="clr-namespace:unvell.ReoGrid;assembly=unvell.ReoGrid"
    Name="edit"
    d:DataContext="{d:DesignInstance Type=controls:EditTableViewModel}"
    mc:Ignorable="d">
    <Grid>
        <reoGrid:ReoGridControl
            x:Name="ReoGrid"
            DataContext="{Binding GridViewModel}"
            SheetTabNewButtonVisible="False" />
    </Grid>
</UserControl>