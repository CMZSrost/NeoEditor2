<Window
    x:Class="NeoEditor.Views.MainWindowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalon="clr-namespace:AvalonDock;assembly=AvalonDock"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:NeoEditor.ViewModels"
    Title="MainWindow"
    Width="800"
    Height="450"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
    Loaded="MainWindow_OnLoaded"
    mc:Ignorable="d">
    <Window.Resources>
        <InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <!--  文件夹图标几何图形  -->
        <PathGeometry x:Key="FolderGeometry">
            M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z
        </PathGeometry>

        <!--  文件图标几何图形  -->
        <PathGeometry x:Key="FileGeometry">
            M13,9H18.5L13,3.5V9M6,2H14L20,8V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V4C4,2.89 4.89,2 6,2M15,18V16H6V18H15M18,14V12H6V14H18Z
        </PathGeometry>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Menu DataContext="{Binding MenuVm}">
            <MenuItem Header="File" StaysOpenOnClick="True">
                <MenuItem Command="{Binding SetProjectCommand}" Header="Set" />
                <!-- <MenuItem Command="{Binding LoadFromXmlCommand}" Header="Load From Xml" /> -->
                <!-- <MenuItem Command="{Binding LoadFromXlsCommand}" Header="Load From Excel" /> -->
            </MenuItem>
            <MenuItem Header="Config" StaysOpenOnClick="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="版本：" />
                    <TextBlock Text="{Binding AppVersion}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="主题：" />
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding CurrentTheme}" />
                </StackPanel>
            </MenuItem>
        </Menu>
        <avalon:DockingManager Grid.Row="1">
            <LayoutRoot>
                <LayoutPanel>
                    <LayoutAnchorablePaneGroup DockWidth="Auto">
                        <LayoutAnchorablePane>
                            <LayoutAnchorable
                                Title="FileSystemView"
                                CanDockAsTabbedDocument="False"
                                CanHide="False">

                                <Grid DataContext="{Binding FileSystemVm}">
                                    <TreeView
                                        ItemsSource="{Binding Roots}"
                                        VirtualizingPanel.IsVirtualizing="True"
                                        VirtualizingPanel.VirtualizationMode="Recycling">
                                        <TreeView.ItemContainerStyle>
                                            <Style BasedOn="{StaticResource TreeViewItemBaseStyle}" TargetType="TreeViewItem">
                                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                            </Style>
                                        </TreeView.ItemContainerStyle>
                                        <TreeView.ItemTemplate>
                                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.InputBindings>
                                                        <MouseBinding Command="{Binding OpenCommand}" Gesture="LeftDoubleClick" />
                                                    </StackPanel.InputBindings>
                                                    <Path
                                                        Width="14"
                                                        Height="14"
                                                        Margin="0,0,5,0"
                                                        Data="{StaticResource FolderGeometry}"
                                                        Fill="{DynamicResource PrimaryBrush}"
                                                        Stretch="Uniform"
                                                        Visibility="{Binding IsDirectory, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                                    <Path
                                                        Width="14"
                                                        Height="14"
                                                        Margin="0,0,5,0"
                                                        Data="{StaticResource FileGeometry}"
                                                        Fill="{DynamicResource InfoBrush}"
                                                        Stretch="Uniform"
                                                        Visibility="{Binding IsDirectory, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                                </StackPanel>
                                            </HierarchicalDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                    <!-- <StackPanel Orientation="Horizontal"> -->
                                    <!--     <Button Command="{Binding OpenEditTableCommand}">打开编辑页</Button> -->
                                    <!-- </StackPanel> -->
                                </Grid>

                            </LayoutAnchorable>
                            <LayoutAnchorable
                                Title="ProjectView"
                                CanDockAsTabbedDocument="False"
                                CanHide="False">

                                <Grid DataContext="{Binding ProjectVm}">
                                    <ListView
                                        ItemsSource="{Binding Mods}"
                                        VirtualizingPanel.IsVirtualizing="True"
                                        VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn DisplayMemberBinding="{Binding ModIndex}" Header="ModIndex" />
                                                <GridViewColumn DisplayMemberBinding="{Binding ModName}" Header="ModName" />
                                                <GridViewColumn DisplayMemberBinding="{Binding ModDirectoryName}" Header="ModDirectory" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <!-- <StackPanel Orientation="Horizontal"> -->
                                    <!--     <Button Command="{Binding OpenEditTableCommand}">打开编辑页</Button> -->
                                    <!-- </StackPanel> -->
                                </Grid>

                            </LayoutAnchorable>
                            <LayoutAnchorable
                                Title="LogView"
                                CanDockAsTabbedDocument="False"
                                CanHide="False">
                                <Grid DataContext="{Binding LoggerVm}">

                                    <ListView
                                        ItemsSource="{Binding Logs}"
                                        VirtualizingPanel.IsVirtualizing="True"
                                        VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn DisplayMemberBinding="{Binding Level}" Header="Level" />
                                                <GridViewColumn DisplayMemberBinding="{Binding Message}" Header="Message" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Grid>

                            </LayoutAnchorable>
                        </LayoutAnchorablePane>
                    </LayoutAnchorablePaneGroup>
                    <LayoutDocumentPaneGroup DockHeight="*" DockWidth="*">
                        <LayoutDocumentPane x:Name="DocumentPane" />
                    </LayoutDocumentPaneGroup>
                </LayoutPanel>
            </LayoutRoot>
        </avalon:DockingManager>
        <StatusBar Grid.Row="2">
            <TextBlock>waiting</TextBlock>
            <TextBlock>waiting</TextBlock>
        </StatusBar>
    </Grid>

</Window>