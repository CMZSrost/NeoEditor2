<Window
    x:Class="NeoEditor.Views.EditProfileWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dto="clr-namespace:NeoEditor.Data.DTO"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:NeoEditor.ViewModels"
    Title="{Binding Loc[EditProfileWindowTitle]}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="viewModels:EditProfileWindowViewModel"
    mc:Ignorable="d">
    <Design.DataContext>
        <viewModels:EditProfileWindowViewModel />
    </Design.DataContext>
    <Grid Margin="10" RowDefinitions="Auto,*,Auto">
        <StackPanel
            Margin="0,0,0,10"
            HorizontalAlignment="Left"
            Orientation="Horizontal">
            <Button
                Margin="5,0"
                Command="{Binding AddCommand}"
                Content="{Binding Loc[Add]}" />
            <Button
                Margin="5,0"
                Command="{Binding DeleteCommand}"
                Content="{Binding Loc[Delete]}" />
        </StackPanel>
        <DataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            CanUserReorderColumns="False"
            ItemsSource="{Binding Entries}"
            SelectedItem="{Binding SelectedEntry}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Type}"
                    Header="{Binding Loc[Type]}" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Name}"
                    Header="{Binding Loc[Name]}" />
                <DataGridTextColumn
                    Width="2*"
                    Binding="{Binding Path}"
                    Header="{Binding Loc[Path]}" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel
            Grid.Row="2"
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="5,0"
                Command="{Binding SaveCommand}"
                Content="{Binding Loc[Save]}" />
            <Button
                Width="80"
                Margin="5,0"
                Command="{Binding CancelCommand}"
                Content="{Binding Loc[Cancel]}" />
        </StackPanel>
    </Grid>
</Window>