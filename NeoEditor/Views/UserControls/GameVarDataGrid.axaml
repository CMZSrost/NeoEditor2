<UserControl
    x:Class="NeoEditor.Views.UserControls.GameVarDataGrid"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:game="clr-namespace:NeoEditor.Data.Model.Game"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:userControls="clr-namespace:NeoEditor.Views.UserControls"
    xmlns:viewModels="clr-namespace:NeoEditor.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="viewModels:GameVarDataGridViewModel"
    mc:Ignorable="d">
    <Design.DataContext>
        <viewModels:GameVarDataGridViewModel />
    </Design.DataContext>
    <userControls:SearchableDataGrid x:Name="InnerGrid" />
</UserControl>