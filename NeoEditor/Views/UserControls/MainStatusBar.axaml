<UserControl
    x:Class="NeoEditor.Views.UserControls.MainStatusBar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mainContent="clr-namespace:NeoEditor.ViewModels.MainContent"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:NeoEditor.ViewModels"
    d:DesignHeight="32"
    d:DesignWidth="800"
    x:DataType="vm:MainWindowViewModel"
    mc:Ignorable="d">
    <Border
        Padding="8,4"
        Background="{DynamicResource ThemeControlMidBrush}"
        BorderBrush="{DynamicResource ThemeControlLowBrush}"
        BorderThickness="1,1,0,0">
        <Grid ColumnDefinitions="Auto,Auto,12,Auto,*">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}"
                       Text="{Binding OpenedDocuments.Count, StringFormat='Docs: {0}'}" />
            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11"
                       Text="{Binding DocumentWorkspace.ActiveDocumentTitle}" />
        </Grid>
    </Border>
</UserControl>