<UserControl
    x:Class="NeoEditor.Views.UserControls.ModGameDataTabsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mainContent="clr-namespace:NeoEditor.ViewModels.MainContent"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:userControls="clr-namespace:NeoEditor.Views.UserControls"
    x:Name="Root"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    mc:Ignorable="d">
    <DockPanel>
        <Border
            Margin="0,0,0,6"
            Padding="6,4"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            CornerRadius="4"
            DockPanel.Dock="Top">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <!--  Group 1: Navigation  -->
                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="2">
                    <Button
                        Click="OnUndoClick"
                        IsEnabled="{Binding CanUndo, ElementName=Root}"
                        ToolTip.Tip="{Binding Loc[UndoTooltip], ElementName=Root}">
                        <avalonia:SymbolIcon FontSize="15" Symbol="ArrowUndo" />
                    </Button>
                    <Button
                        Click="OnRedoClick"
                        IsEnabled="{Binding CanRedo, ElementName=Root}"
                        ToolTip.Tip="{Binding Loc[RedoTooltip], ElementName=Root}">
                        <avalonia:SymbolIcon FontSize="15" Symbol="ArrowRedo" />
                    </Button>
                    <Separator
                        Width="1"
                        Margin="4,2"
                        VerticalAlignment="Stretch" />
                    <Button
                        Click="OnBackNavigationClick"
                        IsEnabled="{Binding CanNavigateBack, ElementName=Root}"
                        ToolTip.Tip="{Binding Loc[NavigateBack], ElementName=Root}">
                        <avalonia:SymbolIcon FontSize="15" Symbol="ArrowLeft" />
                    </Button>
                    <Button
                        Click="OnLocateClick"
                        ToolTip.Tip="{Binding Loc[LocateRowTooltip], ElementName=Root}">
                        <avalonia:SymbolIcon FontSize="15" Symbol="Target" />
                    </Button>
                </StackPanel>

                <!--  Group 2: Row operations  -->
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="2">
                    <Button
                        Click="OnAddRowButtonClick"
                        IsEnabled="{Binding CanAddRow, ElementName=Root}"
                        ToolTip.Tip="{Binding Loc[AddRow], ElementName=Root}">
                        <avalonia:SymbolIcon FontSize="15" Symbol="Add" />
                    </Button>
                    <Button
                        Click="OnDeleteRowButtonClick"
                        IsEnabled="{Binding CanDeleteRow, ElementName=Root}"
                        ToolTip.Tip="{Binding Loc[DeleteRow], ElementName=Root}">
                        <avalonia:SymbolIcon FontSize="15" Symbol="Subtract" />
                    </Button>
                    <Button
                        Padding="4,2"
                        VerticalAlignment="Center"
                        Click="OnColumnManagerClick"
                        ToolTip.Tip="{Binding Loc[ColumnManagerTooltip], ElementName=Root}">
                        <avalonia:SymbolIcon FontSize="15" Symbol="Options" />
                    </Button>
                </StackPanel>

                <!--  Center: status + merge-view controls  -->
                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}"
                        Text="{Binding SavePreviewStatusText, ElementName=Root}" />
                    <ProgressBar
                        Width="100"
                        Height="4"
                        VerticalAlignment="Center"
                        IsIndeterminate="True"
                        IsVisible="{Binding IsPreparingSavePreview, ElementName=Root}" />
                </StackPanel>

                <!--  Group 3: Merge-view controls  -->
                <StackPanel
                    Grid.Column="3"
                    Orientation="Horizontal"
                    Spacing="4">
                    <ComboBox
                        x:Name="ModFilterCombo"
                        Width="110"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsMergeView, ElementName=Root}"
                        SelectionChanged="OnModFilterChanged" />
                    <ToggleButton
                        x:Name="ShowAllToggle"
                        Padding="6,4"
                        Click="OnToggleShowAllClick"
                        Content="{Binding Loc[ShowAll], ElementName=Root}"
                        FontSize="11"
                        IsVisible="{Binding IsMergeView, ElementName=Root}" />
                </StackPanel>

                <!--  Group 4: Save actions  -->
                <StackPanel
                    Grid.Column="4"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        Padding="8,3"
                        VerticalAlignment="Center"
                        Click="OnCreateModFromBrowseClick"
                        Content="{Binding Loc[CreateModToEdit], ElementName=Root}"
                        FontSize="12"
                        IsVisible="{Binding IsBrowseMode, ElementName=Root}" />
                    <!--  Quick Save: DB only, Ctrl+S  -->
                    <Button
                        Click="OnQuickSaveClick"
                        Content="{Binding Loc[QuickSave], ElementName=Root}"
                        FontWeight="SemiBold"
                        IsEnabled="{Binding CanStartSavePreview, ElementName=Root}"
                        ToolTip.Tip="{Binding Loc[QuickSaveTooltip], ElementName=Root}" />
                    <!--  Save & Export: DB + XML diff  -->
                    <Button
                        Click="OnSaveAndExportClick"
                        Content="{Binding Loc[SaveAndExport], ElementName=Root}"
                        IsEnabled="{Binding CanStartSavePreview, ElementName=Root}"
                        ToolTip.Tip="{Binding Loc[SaveAndExportTooltip], ElementName=Root}" />
                    <Button
                        x:Name="SaveLaunchBtn"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Click="OnSaveAndLaunchClick"
                        IsEnabled="{Binding CanStartSavePreview, ElementName=Root}"
                        ToolTip.Tip="{Binding Loc[SaveAndLaunchTooltip], ElementName=Root}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <avalonia:SymbolIcon FontSize="14" Symbol="Play" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding Loc[Launch], ElementName=Root}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Persistence debug bar  -->
        <Border
            x:Name="DebugBar"
            MinHeight="18"
            Margin="0,0,0,2"
            Padding="6,2"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            CornerRadius="2"
            Cursor="Hand"
            DockPanel.Dock="Top"
            Tapped="OnDebugInfoClick">
            <TextBlock
                x:Name="DebugText"
                VerticalAlignment="Center"
                FontSize="10"
                Foreground="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}"
                Text="{Binding PersistenceDebugText, ElementName=Root}" />
        </Border>

        <!--  Empty mod guidance overlay  -->
        <Border
            x:Name="EmptyModBanner"
            Margin="16,8"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            CornerRadius="8"
            IsVisible="{Binding IsEmptyMod, ElementName=Root}">
            <StackPanel HorizontalAlignment="Center" Spacing="12">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="{Binding Loc[EmptyModMessage], ElementName=Root}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}"
                    Text="{Binding Loc[EmptyModHint], ElementName=Root}" />
                <Button
                    Padding="16,8"
                    HorizontalAlignment="Center"
                    Click="OnAddRowButtonClick"
                    FontSize="14"
                    FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock FontSize="18" Text="+" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding Loc[AddFirstEntity], ElementName=Root}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid x:Name="ContentGrid">
            <DockPanel Grid.Column="0">
                <!--  Single FilterText for ALL tabs — survives tab switches  -->
                <TextBox
                    Margin="0,0,0,4"
                    DockPanel.Dock="Top"
                    Text="{Binding FilterText, ElementName=Root}"
                    Watermark="{Binding Loc[SearchHelpTooltip], ElementName=Root}" />
                <Grid RowDefinitions="Auto,*">
                    <!--  Tab strip: only the headers. Content is below, never recreated.  -->
                    <TabControl
                        x:Name="DataTabs"
                        Grid.Row="0"
                        ItemsSource="{Binding Tabs, ElementName=Root}">
                        <TabControl.ItemTemplate>
                            <DataTemplate DataType="mainContent:GameDataTypeTabItem">
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Styles>
                                        <Style Selector="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                        </Style>
                                    </TextBlock.Styles>
                                    <Run Text="{Binding Header}" />
                                </TextBlock>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate DataType="mainContent:GameDataTypeTabItem">
                                <Panel Height="0" />
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                    <!--  Single DataGrid — survives tab switches. ItemsSource is swapped in code-behind.  -->
                    <Grid Grid.Row="1">
                        <userControls:SearchableDataGrid
                            x:Name="SharedDataGrid"
                            ReadOnly="{Binding ReadOnly, ElementName=Root}"
                            ShowRowDetails="{Binding IsMergeView, ElementName=Root}" />
                        <!--  Find/Replace overlay  -->
                        <userControls:FindReplacePanel
                            x:Name="FindPanel"
                            Margin="0,4,8,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top" />
                        <!--  Loading overlay  -->
                        <Border
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="#80000000"
                            IsVisible="{Binding IsLoading, ElementName=Root}">
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                                <ProgressBar
                                    Width="200"
                                    Height="6"
                                    IsIndeterminate="True" />
                                <TextBlock
                                    FontSize="14"
                                    Foreground="White"
                                    Text="{Binding Loc[Loading], ElementName=Root}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>