<UserControl
    x:Class="NeoEditor.Views.UserControls.ModImagesDocumentView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
    xmlns:behaviors="clr-namespace:NeoEditor.Helper.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mainContent="clr-namespace:NeoEditor.ViewModels.MainContent"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="mainContent:ModImagesDocument"
    mc:Ignorable="d">
    <Grid
        MinHeight="0"
        ColumnDefinitions="300,4,*,220"
        ColumnSpacing="12"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="12">
        <Border
            Grid.RowSpan="3"
            Padding="8"
            BorderBrush="DarkGray"
            BorderThickness="1">
            <DockPanel LastChildFill="True">
                <StackPanel
                    Margin="0,0,0,8"
                    DockPanel.Dock="Top"
                    Spacing="8">
                    <StackPanel
                        HorizontalAlignment="Left"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Button Command="{Binding ImportImagesCommand}" ToolTip.Tip="{Binding Loc[ImportImagesTooltip]}">
                            <avalonia:SymbolIcon Symbol="Add" />
                        </Button>
                        <Button Command="{Binding SaveCommand}" ToolTip.Tip="{Binding Loc[SaveModImagesTooltip]}">
                            <avalonia:SymbolIcon Symbol="Save" />
                        </Button>
                        <Button Command="{Binding RenameImagePairCommand}" ToolTip.Tip="{Binding Loc[RenameImagePairTooltip]}">
                            <avalonia:SymbolIcon Symbol="Edit" />
                        </Button>
                        <Button Command="{Binding DeleteImagePairCommand}" ToolTip.Tip="{Binding Loc[DeleteImagePairTooltip]}">
                            <avalonia:SymbolIcon Symbol="Delete" />
                        </Button>
                        <Button
                            Margin="5,0"
                            Command="{Binding MoveUpCommand}"
                            ToolTip.Tip="{Binding Loc[MoveUpImagePairTooltip]}">
                            <avalonia:SymbolIcon Symbol="ArrowUp" />
                        </Button>
                        <Button
                            Margin="5,0"
                            Command="{Binding MoveDownCommand}"
                            ToolTip.Tip="{Binding Loc[MoveDownImagePairTooltip]}">
                            <avalonia:SymbolIcon Symbol="ArrowDown" />
                        </Button>
                    </StackPanel>
                    <TextBlock FontWeight="Bold" Text="{Binding Loc[ShowImage]}" />
                </StackPanel>
                <ListBox
                    x:Name="ImagePairsList"
                    MinHeight="0"
                    ItemsSource="{Binding ImagePairs}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectedItem="{Binding SelectedPair}">
                    <Interaction.Behaviors>
                        <behaviors:ListBoxDragWheelScrollBehavior />
                        <ContextDropBehavior Handler="{Binding ImagePairDropHandler}" />
                    </Interaction.Behaviors>
                    <ListBox.Styles>
                        <Style Selector="ListBox#ImagePairsList &gt; ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,2" />
                            <Setter Property="Padding" Value="6,4" />
                            <Setter Property="CornerRadius" Value="4" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="(Interaction.Behaviors)">
                                <BehaviorCollectionTemplate>
                                    <BehaviorCollection>
                                        <ContextDragBehavior />
                                        <behaviors:ContextMenuPlacementTargetBehavior />
                                    </BehaviorCollection>
                                </BehaviorCollectionTemplate>
                            </Setter>
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu x:DataType="mainContent:ModImagesDocument" DataContext="{Binding DataContext, ElementName=ImagePairsList}">
                                        <MenuItem
                                            Command="{Binding RenameImagePairCommand}"
                                            CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}"
                                            Header="{Binding Loc[RenameImagePair]}" />
                                        <MenuItem
                                            Command="{Binding DeleteImagePairCommand}"
                                            CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}"
                                            Header="{Binding Loc[Delete]}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style Selector="ListBox#ImagePairsList &gt; ListBoxItem.rename-highlighted">
                            <Setter Property="Background" Value="#334F7BFF" />
                        </Style>
                        <Style Selector="ListBox#ImagePairsList &gt; ListBoxItem Border#DropIndicatorTop">
                            <Setter Property="Opacity" Value="0" />
                        </Style>
                        <Style Selector="ListBox#ImagePairsList &gt; ListBoxItem Border#DropIndicatorBottom">
                            <Setter Property="Opacity" Value="0" />
                        </Style>
                        <Style Selector="ListBox#ImagePairsList &gt; ListBoxItem.drop-before Border#DropIndicatorTop">
                            <Setter Property="Opacity" Value="1" />
                        </Style>
                        <Style Selector="ListBox#ImagePairsList &gt; ListBoxItem.drop-after Border#DropIndicatorBottom">
                            <Setter Property="Opacity" Value="1" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="mainContent:ModImagePairItem">
                            <Grid RowDefinitions="2,Auto,2">
                                <Border
                                    x:Name="DropIndicatorTop"
                                    Grid.Row="0"
                                    Background="#4F7BFF"
                                    CornerRadius="1" />
                                <TextBlock
                                    Grid.Row="1"
                                    Text="{Binding DisplayName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip.Tip="{Binding DisplayName}" />
                                <Border
                                    x:Name="DropIndicatorBottom"
                                    Grid.Row="2"
                                    Background="#4F7BFF"
                                    CornerRadius="1" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="1" />

        <TextBlock
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="2"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsVisible="{Binding HasNoImages}"
            Text="{Binding Loc[NoImagesFound]}" />

        <Border
            Grid.Row="0"
            Grid.Column="2"
            Padding="8"
            BorderBrush="DarkGray"
            BorderThickness="1"
            IsVisible="{Binding HasSelectedPair}">
            <StackPanel Spacing="4">
                <TextBlock
                    FontWeight="Bold"
                    Text="{Binding SelectedNormalName}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    FontSize="11"
                    Opacity="0.7"
                    Text="{Binding SelectedNormalPath}"
                    TextWrapping="Wrap" />
                <TextBlock
                    FontSize="11"
                    Opacity="0.7"
                    Text="{Binding SelectedNormalDimensions}" />
            </StackPanel>
        </Border>

        <Button
            Grid.Row="0"
            Grid.Column="3"
            Padding="8"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Top"
            Background="Transparent"
            BorderBrush="DarkGray"
            BorderThickness="1"
            Command="{Binding ShowPreviewCommand}"
            CommandParameter="Normal"
            IsVisible="{Binding HasSelectedPair}">
            <Image Source="{Binding SelectedNormalImage}" Stretch="None" />
        </Button>

        <Border
            Grid.Row="1"
            Grid.Column="2"
            Padding="8"
            BorderBrush="DarkGray"
            BorderThickness="1"
            IsVisible="{Binding HasSelectedPair}">
            <StackPanel Spacing="4">
                <TextBlock
                    FontWeight="Bold"
                    Text="{Binding SelectedX2Name}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    FontSize="11"
                    Opacity="0.7"
                    Text="{Binding SelectedX2Path}"
                    TextWrapping="Wrap" />
                <TextBlock
                    FontSize="11"
                    Opacity="0.7"
                    Text="{Binding SelectedX2Dimensions}" />
            </StackPanel>
        </Border>

        <Button
            Grid.Row="1"
            Grid.Column="3"
            Padding="8"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Top"
            Background="Transparent"
            BorderBrush="DarkGray"
            BorderThickness="1"
            Command="{Binding ShowPreviewCommand}"
            CommandParameter="X2"
            IsVisible="{Binding HasSelectedPair}">
            <Image Source="{Binding SelectedX2Image}" Stretch="None" />
        </Button>

        <Border
            Grid.Row="2"
            Grid.Column="2"
            Grid.ColumnSpan="2"
            MinHeight="0"
            Padding="8"
            BorderBrush="DarkGray"
            BorderThickness="1"
            IsVisible="{Binding HasSelectedPair}">
            <Grid
                MinHeight="0"
                RowDefinitions="Auto,Auto,Auto,*"
                RowSpacing="6">
                <TextBlock
                    FontWeight="Bold"
                    Text="{Binding PreviewName}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Row="1"
                    FontSize="11"
                    Opacity="0.7"
                    Text="{Binding PreviewPath}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Row="2"
                    FontSize="11"
                    Opacity="0.7"
                    Text="{Binding PreviewDimensions}" />
                <ScrollViewer
                    Grid.Row="3"
                    MinHeight="0"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>

