<UserControl
    x:Class="NeoEditor.Views.UserControls.DataBrowserView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:explorerPane="clr-namespace:NeoEditor.ViewModels.ExplorerPane"
    xmlns:helper="clr-namespace:NeoEditor.Helper"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    x:DataType="explorerPane:DataBrowserViewModel"
    mc:Ignorable="d">

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="6,4" Margin="0,0,0,6"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" CornerRadius="4">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Loc[DataBrowserTitle]}" />
                    <TextBlock FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}"
                               Text="{Binding StatusText}" />
                </StackPanel>
                <Button Grid.Column="1" Padding="4,2" Command="{Binding RefreshCommand}"
                        ToolTip.Tip="{Binding Loc[Refresh]}">
                    <avalonia:SymbolIcon FontSize="14" Symbol="ArrowClockwise" />
                </Button>
            </Grid>
        </Border>

        <ScrollViewer>
            <StackPanel Spacing="4" Margin="4,0">
                <ItemsControl ItemsSource="{Binding DomainGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="helper:DomainGroup">
                            <Expander Margin="0,2" IsExpanded="True">
                                <Expander.Header>
                                    <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding Name}" />
                                </Expander.Header>
                                <StackPanel Spacing="1" Margin="16,4,0,4">
                                    <ItemsControl ItemsSource="{Binding EntityTypes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="helper:EntityTypeGroup">
                                                <Button Padding="8,4" HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Command="{Binding #Root.OpenEntityTypeTyped}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding TypeName}" />
                                                        <TextBlock FontSize="11"
                                                                   Foreground="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}"
                                                                   Text="{Binding EntityCount, StringFormat='({0})'}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
