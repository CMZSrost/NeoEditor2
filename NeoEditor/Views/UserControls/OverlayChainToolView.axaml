<UserControl
    x:Class="NeoEditor.Views.UserControls.OverlayChainToolView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mainContent="clr-namespace:NeoEditor.ViewModels.MainContent"
    x:DataType="mainContent:OverlayChainToolContent">
    <Border Padding="6,4">
        <Grid RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,6">
                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Loc[OverlayChainTitle]}"
                           Foreground="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}" />
                <TextBlock FontSize="13" FontWeight="Bold"
                           Text="{Binding EntitySubject}"
                           TextWrapping="Wrap" />
                <TextBlock FontSize="10"
                           Foreground="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}"
                           Text="{Binding EntityType}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="6">
                    <!-- Winner -->
                    <Border Padding="8,6" CornerRadius="4"
                            Background="#1A4CAF50"
                            BorderBrush="#4CAF50"
                            BorderThickness="1"
                            IsVisible="{Binding HasWinners}">
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#4CAF50" Text="{Binding Loc[OverlayChainWinner]}" />
                            <ItemsControl ItemsSource="{Binding Winners}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="mainContent:ChainEntryViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock FontSize="12" FontWeight="Bold" Text="{Binding ModName}" />
                                            <TextBlock FontSize="11" Foreground="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}"
                                                       Text="{Binding Subject}" />
                                            <TextBlock FontSize="10" Foreground="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}"
                                                       Text="{Binding Id, StringFormat='(id={0})'}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Losers (overridden) -->
                    <Border Padding="8,6" CornerRadius="4"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            IsVisible="{Binding HasLosers}">
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="10" FontWeight="Bold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}"
                                       Text="{Binding Loc[OverlayChainOverridden]}" />
                            <ItemsControl ItemsSource="{Binding Losers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="mainContent:ChainEntryViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}"
                                                       Text="{Binding ModName}" />
                                            <TextBlock FontSize="10" Foreground="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}"
                                                       Text="{Binding Subject}" />
                                            <TextBlock FontSize="9" Foreground="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}"
                                                       Text="{Binding Id, StringFormat='(id={0})'}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Empty state -->
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}"
                        Text="{Binding Loc[OverlayChainEmpty]}"
                        TextWrapping="Wrap"
                        IsVisible="{Binding HasNoEntity}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
