<UserControl
    x:Class="NeoEditor.Views.UserControls.SearchResultsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helper="clr-namespace:NeoEditor.Helper"
    xmlns:mainContent="clr-namespace:NeoEditor.ViewModels.MainContent"
    x:Name="Root"
    x:DataType="mainContent:BottomToolsViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <!--  Search input bar  -->
        <DockPanel Grid.Row="0" Margin="4,4,4,2">
            <Button
                Padding="6,2"
                Command="{Binding BottomSearchCommand}"
                Content="{Binding Loc[Search]}"
                DockPanel.Dock="Right"
                FontSize="10" />
            <Button
                Margin="0,0,4,0"
                Padding="5,2"
                Command="{Binding ClearSearchCommand}"
                Content="✕"
                DockPanel.Dock="Right"
                FontSize="9"
                ToolTip.Tip="{Binding Loc[BottomSearchClear]}" />
            <ProgressBar
                Height="4"
                Margin="0,2,0,0"
                DockPanel.Dock="Bottom"
                IsIndeterminate="True"
                IsVisible="{Binding IsBottomSearching}" />
            <TextBox
                Padding="4,2"
                FontSize="11"
                Text="{Binding BottomSearchText}"
                Watermark="{Binding Loc[BottomSearchWatermark]}">
                <TextBox.KeyBindings>
                    <KeyBinding Command="{Binding BottomSearchCommand}" Gesture="Enter" />
                </TextBox.KeyBindings>
            </TextBox>
        </DockPanel>

        <!--  Recent searches  -->
        <ItemsControl
            Grid.Row="1"
            Margin="4,0,4,2"
            ItemsSource="{Binding RecentSearches}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="x:String">
                    <Button
                        Margin="0,0,4,2"
                        Padding="4,1"
                        Command="{Binding #Root.DataContext.SearchRecentCommand}"
                        CommandParameter="{Binding}"
                        Content="{Binding}"
                        FontSize="9" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  Summary  -->
        <TextBlock
            Grid.Row="2"
            Margin="6,0,6,2"
            FontSize="10"
            Foreground="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}"
            Text="{Binding SearchSummary}" />

        <!--  Results grouped by type  -->
        <ListBox
            Grid.Row="3"
            FontFamily="Consolas,Courier New"
            FontSize="11"
            ItemsSource="{Binding SearchResultGroups}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="helper:SearchResultGroup">
                    <StackPanel Margin="2,2,2,6">
                        <TextBlock
                            Margin="2,1"
                            FontSize="11"
                            FontWeight="Bold"
                            Text="{Binding TypeName}" />
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="helper:SearchResultItem">
                                    <TextBlock
                                        Margin="12,1,2,1"
                                        Cursor="Hand"
                                        DoubleTapped="OnSearchResultDoubleTapped"
                                        FontSize="10"
                                        Foreground="Teal"
                                        PointerPressed="OnSearchResultPointerPressed"
                                        Text="{Binding DisplayText}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
