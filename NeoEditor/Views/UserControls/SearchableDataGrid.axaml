<UserControl
    x:Class="NeoEditor.Views.UserControls.SearchableDataGrid"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helper="clr-namespace:NeoEditor.Helper"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <DockPanel>
        <!--  DataGrid  -->
        <DataGrid
            AutoGenerateColumns="True"
            AutoGeneratingColumn="OnAutoGeneratingColumn"
            CanUserReorderColumns="True"
            CanUserResizeColumns="True"
            CanUserSortColumns="True"
            ClipboardCopyMode="IncludeHeader"
            BeginningEdit="OnBeginningEdit"
            CellEditEnding="OnCellEditEnding"
            IsReadOnly="{Binding ReadOnly, ElementName=Root}"
            ItemsSource="{Binding ItemsSource, ElementName=Root}"
            LoadingRow="OnLoadingRow"
            SelectionMode="Extended"
            Sorting="OnSorting"
            x:Name="MainGrid">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="CloneMenuItem" Click="OnCloneRowClick" />
                    <MenuItem x:Name="FindRefsMenuItem" Click="OnFindRefsClick" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </DockPanel>
</UserControl>