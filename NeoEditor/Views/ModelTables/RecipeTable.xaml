<UserControl
    x:Class="NeoEditor.Views.ModelTables.RecipeTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:modelTables="clr-namespace:NeoEditor.ViewModels.ModelTables"
    d:DataContext="{d:DesignInstance Type=modelTables:RecipeTableViewModel}"
    d:DesignHeight="300"
    d:DesignWidth="1200"
    mc:Ignorable="d">
    <DockPanel>
        <StackPanel
            Margin="0,0,0,4"
            DockPanel.Dock="Top"
            Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="Filter:" />
            <TextBox
                Width="160"
                Margin="4,0,8,0"
                Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding AddCommand}"
                Content="Add" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding DuplicateCommand}"
                Content="Duplicate" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding DeleteCommand}"
                Content="Delete" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding MoveUpCommand}"
                Content="Up" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding MoveDownCommand}"
                Content="Down" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding ReindexCommand}"
                Content="Reindex" />
            <TextBlock
                Margin="12,0,4,0"
                VerticalAlignment="Center"
                Text="Selected:" />
            <TextBlock VerticalAlignment="Center" Text="{Binding SelectedItem.strName}" />
        </StackPanel>
        <DataGrid
            Margin="0,0,0,0"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            HeadersVisibility="Column"
            IsReadOnly="False"
            ItemsSource="{Binding FilteredItems}"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
            SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="40"
                    Binding="{Binding idx}"
                    Header="Idx" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding modName}"
                    Header="Mod Name" />
                <DataGridTextColumn
                    Width="60"
                    Binding="{Binding modIndex}"
                    Header="Mod Index" />
                <DataGridTextColumn
                    Width="70"
                    Binding="{Binding serialId_}"
                    Header="SerialId" />
                <DataGridCheckBoxColumn
                    Width="60"
                    Binding="{Binding isLast_}"
                    Header="Is Last" />
                <DataGridTextColumn
                    Width="60"
                    Binding="{Binding overId_}"
                    Header="Over Id" />
                <DataGridTextColumn
                    Width="60"
                    Binding="{Binding nID}"
                    Header="nID" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding strName}"
                    Header="Name" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding strSecretName}"
                    Header="Secret Name" />
                <DataGridTextColumn
                    Width="160"
                    Binding="{Binding strTools}"
                    Header="Tools" />
                <DataGridTextColumn
                    Width="160"
                    Binding="{Binding strConsumed}"
                    Header="Consumed" />
                <DataGridTextColumn
                    Width="160"
                    Binding="{Binding strDestroyed}"
                    Header="Destroyed" />
                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding nTreasureID}"
                    Header="TreasureID" />
                <DataGridTextColumn
                    Width="70"
                    Binding="{Binding fHours}"
                    Header="Hours" />
                <DataGridTextColumn
                    Width="70"
                    Binding="{Binding nReverse}"
                    Header="Reverse" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding nHiddenID}"
                    Header="HiddenID" />
                <DataGridCheckBoxColumn
                    Width="70"
                    Binding="{Binding bIdentify}"
                    Header="Identify" />
                <DataGridCheckBoxColumn
                    Width="140"
                    Binding="{Binding bTransferComponents}"
                    Header="Transfer Components" />
                <DataGridTextColumn
                    Width="140"
                    Binding="{Binding vAlsoTry}"
                    Header="Also Try" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding nTempTreasureID}"
                    Header="TempTreasureID" />
                <DataGridCheckBoxColumn
                    Width="120"
                    Binding="{Binding bDegradeOutput}"
                    Header="Degrade Output" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding strType}"
                    Header="Type" />
                <DataGridCheckBoxColumn
                    Width="60"
                    Binding="{Binding bScrap}"
                    Header="Scrap" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

