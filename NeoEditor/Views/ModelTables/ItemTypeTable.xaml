<UserControl
    x:Class="NeoEditor.Views.ModelTables.ItemTypeTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:modelTables="clr-namespace:NeoEditor.ViewModels.ModelTables"
    d:DataContext="{d:DesignInstance Type=modelTables:ItemTypeTableViewModel}"
    d:DesignHeight="300"
    d:DesignWidth="1400"
    mc:Ignorable="d">
    <DockPanel>
        <StackPanel
            Margin="0,0,0,4"
            DockPanel.Dock="Top"
            Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="Filter:" />
            <TextBox
                Width="180"
                Margin="4,0,8,0"
                Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding AddCommand}"
                Content="Add" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding DuplicateCommand}"
                Content="Duplicate" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding DeleteCommand}"
                Content="Delete" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding MoveUpCommand}"
                Content="Up" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding MoveDownCommand}"
                Content="Down" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding ReindexCommand}"
                Content="Reindex" />
            <TextBlock
                Margin="12,0,4,0"
                VerticalAlignment="Center"
                Text="Selected:" />
            <TextBlock VerticalAlignment="Center" Text="{Binding SelectedItemType.strName}" />
        </StackPanel>
        <DataGrid
            Margin="0"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            HeadersVisibility="Column"
            IsReadOnly="False"
            ItemsSource="{Binding FilteredItemTypes}"
            SelectedItem="{Binding SelectedItemType, Mode=TwoWay}"
            SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="40"
                    Binding="{Binding idx}"
                    Header="Idx" />
                <DataGridTextColumn
                    Width="60"
                    Binding="{Binding nGroupID}"
                    Header="Group" />
                <DataGridTextColumn
                    Width="70"
                    Binding="{Binding nSubgroupID}"
                    Header="SubGroup" />
                <DataGridTextColumn
                    Width="140"
                    Binding="{Binding strName}"
                    Header="Name" />
                <DataGridTextColumn
                    Width="180"
                    Binding="{Binding strDesc}"
                    Header="Desc" />
                <DataGridTextColumn
                    Width="180"
                    Binding="{Binding strDescAlt}"
                    Header="DescAlt" />
                <DataGridTextColumn
                    Width="70"
                    Binding="{Binding nCondID}"
                    Header="CondID" />
                <DataGridTextColumn
                    Width="140"
                    Binding="{Binding vImageList}"
                    Header="Images" />
                <DataGridTextColumn
                    Width="140"
                    Binding="{Binding vSpriteList}"
                    Header="Sprites" />
                <DataGridTextColumn
                    Width="140"
                    Binding="{Binding vImageUsage}"
                    Header="ImageUsage" />
                <DataGridTextColumn
                    Width="70"
                    Binding="{Binding fWeight}"
                    Header="Weight" />
                <DataGridTextColumn
                    Width="70"
                    Binding="{Binding fMonetaryValue}"
                    Header="Value" />
                <DataGridTextColumn
                    Width="70"
                    Binding="{Binding fMonetaryValueAlt}"
                    Header="ValueAlt" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding fDurability}"
                    Header="Durability" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding fDegradePerHour}"
                    Header="Degrade/hr" />
                <DataGridTextColumn
                    Width="110"
                    Binding="{Binding fEquipDegradePerHour}"
                    Header="EquipDegrade/hr" />
                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding fDegradePerUse}"
                    Header="Degrade/use" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding vDegradeTreasureIDs}"
                    Header="DegradeTreasureIDs" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding aEquipConditions}"
                    Header="EquipConds" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding aPossessConditions}"
                    Header="PossessConds" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding aUseConditions}"
                    Header="UseConds" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding aCapacities}"
                    Header="Capacities" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding vEquipSlots}"
                    Header="EquipSlots" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding vUseSlots}"
                    Header="UseSlots" />
                <DataGridCheckBoxColumn
                    Width="110"
                    Binding="{Binding bSocketLocked}"
                    Header="SocketLocked" />
                <DataGridTextColumn
                    Width="160"
                    Binding="{Binding vProperties}"
                    Header="Properties" />
                <DataGridTextColumn
                    Width="140"
                    Binding="{Binding aContentIDs}"
                    Header="ContentIDs" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding nFormatID}"
                    Header="FormatID" />
                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding nTreasureID}"
                    Header="TreasureID" />
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding nComponentID}"
                    Header="ComponentID" />
                <DataGridCheckBoxColumn
                    Width="80"
                    Binding="{Binding bMirrored}"
                    Header="Mirrored" />
                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding nSlotDepth}"
                    Header="SlotDepth" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding strChargeProfiles}"
                    Header="ChargeProfiles" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding aAttackModes}"
                    Header="AttackModes" />
                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding nStackLimit}"
                    Header="StackLimit" />
                <DataGridTextColumn
                    Width="140"
                    Binding="{Binding aSwitchIDs}"
                    Header="SwitchIDs" />
                <DataGridTextColumn
                    Width="140"
                    Binding="{Binding aSounds}"
                    Header="Sounds" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

