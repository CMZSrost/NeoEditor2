<UserControl
    x:Class="NeoEditor.Views.ModelTables.AttackModeTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:modelTables="clr-namespace:NeoEditor.ViewModels.ModelTables"
    d:DataContext="{d:DesignInstance Type=modelTables:AttackModeTableViewModel}"
    d:DesignHeight="300"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <DockPanel>
        <StackPanel
            Margin="0,0,0,4"
            DockPanel.Dock="Top"
            Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="Filter:" />
            <TextBox
                Width="140"
                Margin="4,0,8,0"
                Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding AddCommand}"
                Content="Add" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding DuplicateCommand}"
                Content="Duplicate" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding DeleteCommand}"
                Content="Delete" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding MoveUpCommand}"
                Content="Up" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding MoveDownCommand}"
                Content="Down" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding ReindexCommand}"
                Content="Reindex" />
            <TextBlock
                Margin="12,0,4,0"
                VerticalAlignment="Center"
                Text="Selected:" />
            <TextBlock VerticalAlignment="Center" Text="{Binding SelectedItem.strName}" />
        </StackPanel>
        <DataGrid
            Margin="0"
            d:ItemsSource="{Binding Items}"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            HeadersVisibility="Column"
            IsReadOnly="False"
            ItemsSource="{Binding FilteredItems}"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
            SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="40"
                    Binding="{Binding idx}"
                    Header="Idx" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding modName}"
                    Header="Mod Name" />
                <DataGridTextColumn
                    Width="60"
                    Binding="{Binding modIndex}"
                    Header="Mod Index" />
                <DataGridTextColumn
                    Width="70"
                    Binding="{Binding serialId_}"
                    Header="SerialId" />
                <DataGridCheckBoxColumn
                    Width="60"
                    Binding="{Binding isLast_}"
                    Header="Is Last" />
                <DataGridTextColumn
                    Width="60"
                    Binding="{Binding overId_}"
                    Header="Over Id" />
                <DataGridTextColumn
                    Width="60"
                    Binding="{Binding id}"
                    Header="Id" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding strName}"
                    Header="Name" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding strNotes}"
                    Header="Notes" />
                <DataGridTextColumn
                    Width="60"
                    Binding="{Binding nRange}"
                    Header="Range" />
                <DataGridTextColumn
                    Width="60"
                    Binding="{Binding fDamageCut}"
                    Header="Cut" />
                <DataGridTextColumn
                    Width="60"
                    Binding="{Binding fDamageBlunt}"
                    Header="Blunt" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding strChargeProfiles}"
                    Header="Charge Profiles" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding nPenetration}"
                    Header="Penetration" />
                <DataGridTextColumn
                    Width="60"
                    Binding="{Binding nType}"
                    Header="Type" />
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding strSnd}"
                    Header="Sound" />
                <DataGridCheckBoxColumn
                    Width="70"
                    Binding="{Binding bTransfer}"
                    Header="Transfer" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding vAttackerConditions}"
                    Header="Attacker Conditions" />
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding strIMG}"
                    Header="IMG" />
                <DataGridTextColumn
                    Width="70"
                    Binding="{Binding fMorale}"
                    Header="Morale" />
                <DataGridTextColumn
                    Width="140"
                    Binding="{Binding strWieldPhrase}"
                    Header="Wield Phrase" />
                <DataGridTextColumn
                    Width="160"
                    Binding="{Binding vAttackPhrases}"
                    Header="Attack Phrases" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>