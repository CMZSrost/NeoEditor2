<UserControl
    x:Class="NeoEditor.Views.ModelTables.CreatureTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:modelTables="clr-namespace:NeoEditor.ViewModels.ModelTables"
    d:DataContext="{d:DesignInstance Type=modelTables:CreatureTableViewModel}"
    d:DesignHeight="300"
    d:DesignWidth="1200"
    mc:Ignorable="d">
    <DockPanel>
        <StackPanel
            Margin="0,0,0,4"
            DockPanel.Dock="Top"
            Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="Filter:" />
            <TextBox
                Width="160"
                Margin="4,0,8,0"
                Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding AddCommand}"
                Content="Add" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding DuplicateCommand}"
                Content="Duplicate" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding DeleteCommand}"
                Content="Delete" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding MoveUpCommand}"
                Content="Up" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding MoveDownCommand}"
                Content="Down" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding ReindexCommand}"
                Content="Reindex" />
            <TextBlock
                Margin="12,0,4,0"
                VerticalAlignment="Center"
                Text="Selected:" />
            <TextBlock VerticalAlignment="Center" Text="{Binding SelectedItem.strName}" />
        </StackPanel>
        <DataGrid
            Margin="0,0,0,0"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            HeadersVisibility="Column"
            IsReadOnly="False"
            ItemsSource="{Binding FilteredItems}"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
            SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="40"
                    Binding="{Binding idx}"
                    Header="Idx" />
                <DataGridTextColumn
                    Width="140"
                    Binding="{Binding strName}"
                    Header="Name" />
                <DataGridTextColumn
                    Width="140"
                    Binding="{Binding strNamePublic}"
                    Header="Public Name" />
                <DataGridTextColumn
                    Width="200"
                    Binding="{Binding strNotes}"
                    Header="Notes" />
                <DataGridTextColumn
                    Width="140"
                    Binding="{Binding strImg}"
                    Header="Img" />
                <DataGridTextColumn
                    Width="160"
                    Binding="{Binding vEncounterIDs}"
                    Header="Encounters" />
                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding nMovesPerTurn}"
                    Header="Moves/Turn" />
                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding nTreasureID}"
                    Header="TreasureID" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding nFaction}"
                    Header="Faction" />
                <DataGridTextColumn
                    Width="160"
                    Binding="{Binding vAttackModes}"
                    Header="AttackModes" />
                <DataGridTextColumn
                    Width="160"
                    Binding="{Binding vBaseConditions}"
                    Header="BaseConditions" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding nCorpseID}"
                    Header="CorpseID" />
                <DataGridTextColumn
                    Width="160"
                    Binding="{Binding vActivities}"
                    Header="Activities" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

