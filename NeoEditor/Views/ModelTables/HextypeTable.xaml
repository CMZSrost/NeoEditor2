<UserControl
    x:Class="NeoEditor.Views.ModelTables.HextypeTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:modelTables="clr-namespace:NeoEditor.ViewModels.ModelTables"
    d:DataContext="{d:DesignInstance Type=modelTables:HextypeTableViewModel}"
    d:DesignHeight="300"
    d:DesignWidth="1300"
    mc:Ignorable="d">
    <DockPanel>
        <StackPanel
            Margin="0,0,0,4"
            DockPanel.Dock="Top"
            Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="Filter:" />
            <TextBox
                Width="160"
                Margin="4,0,8,0"
                Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding AddCommand}"
                Content="Add" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding DuplicateCommand}"
                Content="Duplicate" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding DeleteCommand}"
                Content="Delete" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding MoveUpCommand}"
                Content="Up" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding MoveDownCommand}"
                Content="Down" />
            <Button
                Margin="0,0,4,0"
                Command="{Binding ReindexCommand}"
                Content="Reindex" />
            <TextBlock
                Margin="12,0,4,0"
                VerticalAlignment="Center"
                Text="Selected:" />
            <TextBlock VerticalAlignment="Center" Text="{Binding SelectedItem.strName}" />
        </StackPanel>
        <DataGrid
            Margin="0,0,0,0"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            HeadersVisibility="Column"
            IsReadOnly="False"
            ItemsSource="{Binding FilteredItems}"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
            SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="40"
                    Binding="{Binding idx}"
                    Header="Idx" />
                <DataGridTextColumn
                    Width="60"
                    Binding="{Binding id}"
                    Header="ID" />
                <DataGridTextColumn
                    Width="140"
                    Binding="{Binding strName}"
                    Header="Name" />
                <DataGridTextColumn
                    Width="180"
                    Binding="{Binding strDesc}"
                    Header="Description" />
                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding nTerrainCost}"
                    Header="TerrainCost" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding nVizLimiter}"
                    Header="VizLimiter" />
                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding nVizIncrease}"
                    Header="VizIncrease" />
                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding nTreasureID}"
                    Header="TreasureID" />
                <DataGridCheckBoxColumn
                    Width="80"
                    Binding="{Binding bPassable}"
                    Header="Passable" />
                <DataGridTextColumn
                    Width="130"
                    Binding="{Binding nScavengeInitialID}"
                    Header="ScavengeInitialID" />
                <DataGridTextColumn
                    Width="160"
                    Binding="{Binding nScavengeItemsIDPerHour}"
                    Header="ScavengeItems/Hr" />
                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding nCampItems}"
                    Header="CampItems" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding vLightLevels}"
                    Header="LightLevels" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding nDefaultCampID}"
                    Header="DefaultCampID" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding nMinRange}"
                    Header="MinRange" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding nMaxRange}"
                    Header="MaxRange" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding vCondIDs}"
                    Header="CondIDs" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

