<Window
    x:Class="NeoEditor.Views.Dialog.ValidationReportDialog"
    xmlns:dialog="clr-namespace:NeoEditor.Views.Dialog"
    x:DataType="dialog:ValidationReportDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="620"
    Height="440"
    MinWidth="440"
    MinHeight="300"
    Title="{Binding Loc[ValidationReportTitle]}"
    WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16">
        <TextBlock Grid.Row="0" x:Name="SummaryText" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ProgressBar
            x:Name="LoadProgress"
            Grid.Row="1"
            Height="6"
            IsIndeterminate="True"
            VerticalAlignment="Center"
            Margin="0,8" />
        <TextBox
            x:Name="ReportText"
            Grid.Row="1"
            IsReadOnly="True"
            AcceptsReturn="True"
            TextWrapping="NoWrap"
            FontFamily="Consolas,Courier New"
            FontSize="12"
            IsVisible="False"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto" />
        <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
            <Button x:Name="CancelBtn" Click="OnCancelClick" Content="{Binding Loc[ValidationCancelSave]}" />
            <Button x:Name="ProceedBtn" Click="OnProceedClick" Content="{Binding Loc[ValidationSaveAnyway]}" />
        </StackPanel>
    </Grid>
</Window>
