<Window
    x:Class="NeoEditor.Views.Dialog.DependencyListDialog"
    xmlns:dialog="clr-namespace:NeoEditor.Views.Dialog"
    x:DataType="dialog:DependencyListDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:CompileBindings="False"
    Width="780"
    Height="460"
    MinWidth="540"
    MinHeight="320"
    Title="{Binding Loc[DependencyCheckTitle]}"
    WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto" Margin="16,12">
        <TextBlock Grid.Row="0" x:Name="SummaryText" FontWeight="SemiBold" Margin="0,0,0,8" />
        <DataGrid Grid.Row="1" x:Name="DepGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserResizeColumns="True" CanUserReorderColumns="True"
                  SelectionMode="Extended" ClipboardCopyMode="IncludeHeader">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{Binding Loc[DependencySource]}" Binding="{Binding SourceEntity}" MinWidth="80" />
                <DataGridTextColumn Header="{Binding Loc[DependencyMod]}" Binding="{Binding SourceMod}" MinWidth="60" />
                <DataGridTextColumn Header="{Binding Loc[DependencyField]}" Binding="{Binding Field}" MinWidth="80" />
                <DataGridTextColumn Header="{Binding Loc[DependencyTarget]}" Binding="{Binding TargetDesc}" MinWidth="100" />
                <DataGridTextColumn Header="{Binding Loc[DependencyIssue]}" Binding="{Binding Issue}" MinWidth="120" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="ExportBtn" Click="OnExportClick" Content="{Binding Loc[DialogExportCsv]}" Width="100" />
            <Button x:Name="CloseBtn" Click="OnCloseClick" Content="{Binding Loc[DialogClose]}" Width="80" />
        </StackPanel>
    </Grid>
</Window>
