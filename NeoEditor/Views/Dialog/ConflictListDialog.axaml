<Window
    x:Class="NeoEditor.Views.Dialog.ConflictListDialog"
    x:DataType="dialog:ConflictListDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialog="clr-namespace:NeoEditor.Views.Dialog"
    x:CompileBindings="False"
    Width="700"
    Height="440"
    MinWidth="500"
    MinHeight="300"
    Title="{Binding Loc[ConflictTitle]}"
    WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto" Margin="16,12">
        <TextBlock Grid.Row="0" x:Name="SummaryText" FontWeight="SemiBold" Margin="0,0,0,8" />
        <DataGrid Grid.Row="1" x:Name="ConflictGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserResizeColumns="True" CanUserReorderColumns="True"
                  SelectionMode="Extended" ClipboardCopyMode="IncludeHeader">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{Binding Loc[ConflictEntityType]}" Binding="{Binding EntityType}" MinWidth="80" />
                <DataGridTextColumn Header="{Binding Loc[ConflictEntity]}" Binding="{Binding EntityLabel}" MinWidth="120" />
                <DataGridTextColumn Header="{Binding Loc[ConflictField]}" Binding="{Binding Field}" MinWidth="80" />
                <DataGridTextColumn Header="{Binding Loc[ConflictMods]}" Binding="{Binding ModNames}" MinWidth="120" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="ExportBtn" Click="OnExportClick" Content="{Binding Loc[DialogExportCsv]}" Width="100" />
            <Button x:Name="CloseBtn" Click="OnCloseClick" Content="{Binding Loc[DialogClose]}" Width="80" />
        </StackPanel>
    </Grid>
</Window>
