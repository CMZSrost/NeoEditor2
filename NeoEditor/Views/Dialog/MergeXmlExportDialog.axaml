<Window
    x:Class="NeoEditor.Views.Dialog.MergeXmlExportDialog"
    x:DataType="dialog:MergeXmlExportDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:userControls="clr-namespace:NeoEditor.Views.UserControls"
    xmlns:dialog="clr-namespace:NeoEditor.Views.Dialog"
    x:Name="Root"
    Width="1100"
    Height="700"
    MinWidth="800"
    MinHeight="500"
    Title="{Binding Loc[MergeExportTitle]}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid
        Margin="12"
        ColumnDefinitions="220,*,*"
        RowDefinitions="Auto,Auto,*,Auto"
        ColumnSpacing="10"
        RowSpacing="10">

        <!-- Headers -->
        <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold" Text="{Binding Loc[MergeExportFiles]}" />
        <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="Bold" Text="{Binding Loc[DiffOldLabel], ElementName=Root}" />
        <TextBlock Grid.Row="0" Grid.Column="2" FontWeight="Bold" Text="{Binding Loc[DiffNewLabel], ElementName=Root}" />

        <!-- Info text -->
        <TextBlock
            Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
            Text="{Binding Loc[MergeExportInfo]}"
            TextWrapping="Wrap"
            Foreground="Gray" />

        <!-- File list -->
        <ListBox
            Grid.Row="2" Grid.Column="0"
            x:Name="FileListBox"
            SelectionMode="Single">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="dialog:MergeXmlExportDialog+ExportItem">
                    <StackPanel Margin="4" Spacing="2">
                        <TextBlock FontWeight="SemiBold" Text="{Binding ModName}" />
                        <TextBlock FontSize="11" Foreground="Gray" Text="{Binding FileName}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Diff view -->
        <userControls:XmlDiffView
            Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
            x:Name="DiffView"
            DocSyntax="XML"
            ReadOnly="True" />

        <!-- Buttons -->
        <StackPanel
            Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="16">
            <Button Click="OnConfirmAllClick" Content="{Binding Loc[MergeExportAll]}" />
            <Button Click="OnCancelClick" Content="{Binding Loc[DialogCancel]}" />
        </StackPanel>
    </Grid>
</Window>
