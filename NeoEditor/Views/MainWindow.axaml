<Window
    x:Class="NeoEditor.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
    xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mainContent="clr-namespace:NeoEditor.ViewModels.MainContent"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:userControls="clr-namespace:NeoEditor.Views.UserControls"
    xmlns:vm="using:NeoEditor.ViewModels"
    x:Name="MainWindowApp"
    Title="{Binding Loc[AppTitle]}"
    d:DesignHeight="500"
    d:DesignWidth="800"
    x:DataType="vm:MainWindowViewModel"
    ClosingBehavior="OwnerAndChildWindows"
    Icon="/Assets/avalonia-logo.ico"
    mc:Ignorable="d">
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>
    <Window.DataTemplates />
    <DockPanel>
        <!--  菜单栏  -->
        <Menu DockPanel.Dock="Top">
            <!--  项目  -->
            <MenuItem Header="{Binding Loc[MenuProject]}">
                <MenuItem Command="{Binding SetFolderCommand}" Header="{Binding Loc[SetFolder]}" />
                <!-- <MenuItem Command="{Binding CreateProjectCommand}" Header="{Binding Loc[MenuProjectCreate]}" /> -->
                <!-- <MenuItem Command="{Binding OpenProjectCommand}" Header="{Binding Loc[MenuProjectOpen]}" /> -->
                <!-- <MenuItem Command="{Binding CloseProjectCommand}" Header="{Binding Loc[MenuProjectClose]}" /> -->
            </MenuItem>
            <!--  语言  -->
            <MenuItem Header="{Binding Path=CurrentCultureInfo.DisplayName}" ItemsSource="{Binding SupportedCultures}">
                <MenuItem.ItemTemplate>
                    <DataTemplate>
                        <MenuItem
                            Command="{Binding ElementName=MainWindowApp, Path=DataContext.ChangeCultureCommand}"
                            CommandParameter="{Binding}"
                            Header="{Binding DisplayName}" />
                    </DataTemplate>
                </MenuItem.ItemTemplate>
            </MenuItem>
        </Menu>
        <!--  底部状态栏  -->
        <StackPanel DockPanel.Dock="Bottom">
            <!-- <TextBlock Text="{Binding Loc[Status]}" /> -->
        </StackPanel>
        <!--  左侧垂直按钮条  -->
        <StackPanel
            Margin="4"
            Orientation="Vertical"
            Spacing="4">
            <Button Command="{Binding TogglePaneCommand}" CommandParameter="Explorer">
                <avalonia:SymbolIcon IconVariant="Regular" Symbol="Folder" />
            </Button>
            <Button Command="{Binding TogglePaneCommand}" CommandParameter="ModDatabase">
                <avalonia:SymbolIcon IconVariant="Regular" Symbol="Database" />
            </Button>
            <Button Command="{Binding TogglePaneCommand}" CommandParameter="Profiles">
                <avalonia:SymbolIcon IconVariant="Regular" Symbol="List" />
            </Button>
            <Button Command="{Binding TogglePaneCommand}" CommandParameter="Search">
                <avalonia:SymbolIcon IconVariant="Regular" Symbol="Search" />
            </Button>
            <Button Command="{Binding TogglePaneCommand}" CommandParameter="Settings">
                <avalonia:SymbolIcon IconVariant="Regular" Symbol="Settings" />
            </Button>
        </StackPanel>
        <!--  分割视图  -->
        <SplitView
            DisplayMode="Inline"
            IsPaneOpen="{Binding SideBarExpanded}"
            OpenPaneLength="500">
            <!--  侧边栏内容区域  -->
            <SplitView.Pane>
                <!-- <ContentControl Content="{Binding CurrentPaneContent}" /> -->
                <userControls:Pane Content="{Binding CurrentPaneContent}" />
            </SplitView.Pane>

            <!--  主内容区（右侧）  -->
            <SplitView.Content>
                <Grid ColumnDefinitions="*" RowDefinitions="Auto,*">
                    <StackPanel
                        Grid.Row="0"
                        Margin="6,4"
                        Orientation="Horizontal"
                        Spacing="6">

                        <Button Command="{Binding AddDocumentCommand}">
                            <avalonia:SymbolIcon Symbol="TabAdd" ToolTip.Tip="{Binding Loc[AddTab]}" />
                        </Button>
                        <!-- <Button Command="{Binding EditProfileCommand}"> -->
                        <!--     <avalonia:SymbolIcon Symbol="ReadingListAdd" ToolTip.Tip="{Binding Loc[AddTab]}" /> -->
                        <!-- </Button> -->
                        <GridSplitter />
                        <DropDownButton>
                            <DropDownButton.Content>
                                <StackPanel>
                                    <avalonia:SymbolIcon Symbol="Tab" />
                                </StackPanel>
                            </DropDownButton.Content>
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Command="{Binding AddDocumentCommand}">
                                        <MenuItem.Header>
                                            <StackPanel>
                                                <avalonia:SymbolIcon Symbol="TabAdd" />
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <TextBlock Text="Current Documents: " />
                        <TextBlock Text="{Binding Documents.Count}" />
                    </StackPanel>
                    <DockControl
                        Grid.Row="1"
                        EnableManagedWindowLayer="False"
                        Factory="{Binding DockFactory}"
                        InitializeFactory="True"
                        InitializeLayout="True"
                        IsDockingEnabled="{Binding IsDockingEnabled, Mode=OneWay}"
                        IsVisible="True">
                        <DockControl.DataTemplates>
                            <DataTemplate x:DataType="mainContent:XmlDiffDocument">
                                <userControls:XmlDiffView
                                    DocSyntax="XmlDoc"
                                    NewXml="{Binding NewXml}"
                                    OldXml="{Binding OldXml}"
                                    ReadOnly="False" />
                                <!-- <userControls:DiffView NewText="{Binding NewXml}" OldText="{Binding OldXml}" /> -->
                            </DataTemplate>
                            <DataTemplate x:DataType="mainContent:XmlDocument">
                                <avaloniaEdit:TextEditor
                                    Document="{Binding Xml, Mode=TwoWay}"
                                    IsReadOnly="True"
                                    ShowLineNumbers="True"
                                    SyntaxHighlighting="XmlDoc" />
                            </DataTemplate>
                        </DockControl.DataTemplates>
                        <RootDock Id="Root" PinnedDockDisplayMode="Inline">
                            <ProportionalDock EnableGlobalDocking="True">
                                <!--  <ToolDock  -->
                                <!--  Alignment="Left"  -->
                                <!--  Column="0"  -->
                                <!--  Id="ToolsPane"  -->
                                <!--  ItemsSource="{Binding DataContext.Tools, ElementName=MainWindowApp}">  -->
                                <!--     <ToolDock.ToolTemplate> -->
                                <!--         <ToolTemplate> -->
                                <!--             <StackPanel Margin="10" x:DataType="Tool"> -->
                                <!--                 <ContentControl Content="{Binding Context}"> -->
                                <!--                     <ContentControl.DataTemplates> -->
                                <!--                         <DataTemplate Content="{StaticResource EditorTemplate}" /> -->
                                <!--                     </ContentControl.DataTemplates> -->
                                <!--                 </ContentControl> -->
                                <!--             </StackPanel> -->
                                <!--         </ToolTemplate> -->
                                <!--     </ToolDock.ToolTemplate> -->
                                <!-- </ToolDock> -->
                                <DocumentDock
                                    CanUpdateItemsSourceOnUnregister="True"
                                    EnableWindowDrag="False"
                                    Id="DocumentsPane"
                                    ItemsSource="{Binding DataContext.Documents, ElementName=MainWindowApp}">
                                    <!--  Define how each document should be displayed  -->
                                    <DocumentDock.DocumentTemplate>
                                        <DocumentTemplate>
                                            <Grid Margin="10" x:DataType="Document">
                                                <ContentControl
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Content="{Binding Context}" />
                                            </Grid>
                                        </DocumentTemplate>
                                    </DocumentDock.DocumentTemplate>
                                </DocumentDock>
                            </ProportionalDock>
                        </RootDock>
                    </DockControl>
                    <!--    -->
                    <!-- <Border> -->
                    <!-- <ContentControl Content="{Binding CurrentMainContent}" /> -->
                    <!-- </Border> -->
                    <!-- <TabControl> -->
                    <!--     <TabItem Header="{Binding Loc[Welcome]}"> -->
                    <!--         <TextBlock></TextBlock> -->
                    <!--     </TabItem> -->
                    <!-- </TabControl> -->
                    <!-- <userControls:SearchableDataGrid Grid.Row="0" ItemsSource="{Binding SampleData}" /> -->


                    <WindowNotificationManager
                        Name="NotificationManager"
                        Grid.Row="0"
                        Grid.RowSpan="{Binding $parent[Grid].RowDefinitions.Count}"
                        Grid.Column="0"
                        Grid.ColumnSpan="{Binding $parent[Grid].ColumnDefinitions.Count}"
                        Position="TopRight" />
                </Grid>

            </SplitView.Content>
        </SplitView>
    </DockPanel>
</Window>