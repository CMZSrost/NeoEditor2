<UserControl
    x:Class="NeoEditor.Plugins.ImageTools.Views.ImageOrchestrationView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:NeoEditor.Plugins.ImageTools.ViewModels"
    x:DataType="vm:ImageOrchestrationViewModel">
    <Border Padding="4">
        <Grid ColumnDefinitions="*,4,Auto" RowDefinitions="Auto,*,Auto">

            <!--  Toolbar row  -->
            <StackPanel
                Grid.Row="0"
                Grid.ColumnSpan="3"
                Margin="0,0,0,4"
                Orientation="Horizontal"
                Spacing="6">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Text="Image Orchestration" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="9"
                    Opacity="0.7"
                    Text="getimages.php declaration order" />
                <Button
                    Padding="4,2"
                    Command="{Binding RefreshCommand}"
                    Content="&#x21BB;"
                    FontSize="12"
                    ToolTip.Tip="Reload getimages.php" />
            </StackPanel>

            <!--  Sources list (left)  -->
            <ListBox
                Grid.Row="1"
                Grid.Column="0"
                MinWidth="180"
                ItemsSource="{Binding Sources}"
                SelectedItem="{Binding SelectedSource}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ImageOrchestrationSourceNode">
                        <StackPanel Spacing="1">
                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Text="{Binding Name}" />
                            <TextBlock
                                FontSize="9"
                                Opacity="0.7"
                                Text="{Binding Summary}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--  Grid splitter  -->
            <GridSplitter
                Grid.Row="1"
                Grid.Column="1"
                Width="4"
                Background="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}" />

            <!--  Pairs pane (right)  -->
            <Border
                Grid.Row="1"
                Grid.Column="2"
                MinWidth="200"
                Padding="6">
                <Grid RowDefinitions="Auto,Auto,*,Auto">

                    <!--  Header: selected source  -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="0,0,0,4"
                        Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Text="{Binding SelectedSource.Name}" />
                            <Border
                                Padding="4,0"
                                CornerRadius="3"
                                IsVisible="{Binding IsReadOnly}">
                                <TextBlock
                                    FontSize="8"
                                    Foreground="Gray"
                                    Text="Read-only" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            FontSize="9"
                            Opacity="0.7"
                            Text="{Binding SelectedSource.GetImagesPath}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!--  Action toolbar  -->
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,0,0,4"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button
                            Padding="6,2"
                            Command="{Binding MoveUpCommand}"
                            Content="&#x2191;"
                            FontSize="10"
                            ToolTip.Tip="Move pair up" />
                        <Button
                            Padding="6,2"
                            Command="{Binding MoveDownCommand}"
                            Content="&#x2193;"
                            FontSize="10"
                            ToolTip.Tip="Move pair down" />
                        <Button
                            Padding="6,2"
                            Command="{Binding AddPairCommand}"
                            Content="+"
                            FontSize="10"
                            ToolTip.Tip="Add image pair (imports files into img/)" />
                        <Button
                            Padding="6,2"
                            Command="{Binding DeletePairCommand}"
                            Content="-"
                            FontSize="10"
                            ToolTip.Tip="Remove pair from declaration" />
                        <Button
                            Padding="6,2"
                            Command="{Binding SaveCommand}"
                            Content="&#x1F4BE;"
                            FontSize="10"
                            ToolTip.Tip="Write getimages.php" />
                    </StackPanel>

                    <!--  Pair list  -->
                    <ListBox
                        Grid.Row="2"
                        ItemsSource="{Binding SelectedSource.Pairs}"
                        SelectedItem="{Binding SelectedPair}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ImageOrchestrationPairItem">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock
                                        FontWeight="Bold"
                                        Foreground="ForestGreen"
                                        IsVisible="{Binding NormalExists}"
                                        Text="&#x2713;" />
                                    <TextBlock
                                        FontWeight="Bold"
                                        Foreground="IndianRed"
                                        IsVisible="{Binding !NormalExists}"
                                        Text="&#x2717;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Text="{Binding NormalImage}"
                                        ToolTip.Tip="{Binding NormalPath}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Opacity="0.4"
                                        Text="/" />
                                    <TextBlock
                                        FontWeight="Bold"
                                        Foreground="ForestGreen"
                                        IsVisible="{Binding X2Exists}"
                                        Text="&#x2713;" />
                                    <TextBlock
                                        FontWeight="Bold"
                                        Foreground="IndianRed"
                                        IsVisible="{Binding !X2Exists}"
                                        Text="&#x2717;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Text="{Binding X2Image}"
                                        ToolTip.Tip="{Binding X2Path}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!--  Empty state  -->
                    <TextBlock
                        Grid.Row="2"
                        FontSize="10"
                        IsVisible="{Binding !HasSelectedSource}"
                        Opacity="0.6"
                        Text="Select a source to inspect its getimages.php."
                        TextWrapping="Wrap" />

                    <!--  Status footer  -->
                    <TextBlock
                        Grid.Row="3"
                        Margin="0,4,0,0"
                        FontSize="9"
                        Foreground="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}"
                        Text="&#x2713; = file exists · &#x2717; = missing (resolved via mod/ then img/ then game img/)." />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>