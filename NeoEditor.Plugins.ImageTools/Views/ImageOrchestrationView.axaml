<UserControl
    x:Class="NeoEditor.Plugins.ImageTools.Views.ImageOrchestrationView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hier="clr-namespace:Avalonia.Controls.DataGridHierarchical;assembly=Avalonia.Controls.DataGrid"
    xmlns:vm="clr-namespace:NeoEditor.Plugins.ImageTools.ViewModels"
    x:DataType="vm:ImageOrchestrationViewModel">
    <Border Padding="4">
        <Grid RowDefinitions="Auto,*,Auto">

            <!--  Toolbar row  -->
            <StackPanel
                Grid.Row="0"
                Margin="0,0,0,4"
                Orientation="Horizontal"
                Spacing="6">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Text="Image Orchestration" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="9"
                    Opacity="0.7"
                    Text="getimages.php declaration order" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="9"
                    IsVisible="{Binding IsLoading}"
                    Opacity="0.7"
                    Text="Loading…" />
                <Button
                    Padding="4,2"
                    Command="{Binding RefreshCommand}"
                    Content="&#x21BB;"
                    FontSize="12"
                    ToolTip.Tip="Reload getimages.php" />
                <Separator
                    Width="1"
                    Margin="2,2"
                    VerticalAlignment="Stretch" />
                <Button
                    Padding="6,2"
                    Command="{Binding MoveUpCommand}"
                    Content="&#x2191;"
                    FontSize="10"
                    ToolTip.Tip="Move pair up" />
                <Button
                    Padding="6,2"
                    Command="{Binding MoveDownCommand}"
                    Content="&#x2193;"
                    FontSize="10"
                    ToolTip.Tip="Move pair down" />
                <Button
                    Padding="6,2"
                    Command="{Binding AddPairCommand}"
                    Content="+"
                    FontSize="10"
                    ToolTip.Tip="Add image pair (imports files into img/)" />
                <Button
                    Padding="6,2"
                    Command="{Binding DeletePairCommand}"
                    Content="-"
                    FontSize="10"
                    ToolTip.Tip="Remove pair from declaration" />
                <Button
                    Padding="6,2"
                    Command="{Binding SaveCommand}"
                    Content="&#x1F4BE;"
                    FontSize="10"
                    ToolTip.Tip="Write getimages.php" />
            </StackPanel>

            <!--  Source → pairs hierarchical grid (round22)  -->
            <DataGrid
                Grid.Row="1"
                AutoGenerateColumns="False"
                CanUserReorderColumns="False"
                CanUserResizeColumns="True"
                CanUserSortColumns="False"
                Classes="hierarchical"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                HierarchicalModel="{Binding TreeModel}"
                HierarchicalRowsEnabled="True"
                IsReadOnly="True"
                SelectedItem="{Binding SelectedRow}">
                <DataGrid.Columns>
                    <!--
                        Tree column: source name+summary / pair normal name. The hierarchical
                        column's cell template gets the row ITEM as DataContext (like Profile
                        Tool), so it binds the unified row shape directly — never via the node.
                    -->
                    <DataGridHierarchicalColumn
                        Width="2*"
                        x:CompileBindings="False"
                        Binding="{Binding Item}"
                        Header="Name">
                        <DataGridHierarchicalColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="1" ToolTip.Tip="{Binding RowToolTip}">
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Text="{Binding RowTitle}" />
                                    <TextBlock
                                        FontSize="9"
                                        IsVisible="{Binding HasRowSubtitle}"
                                        Opacity="0.7"
                                        Text="{Binding RowSubtitle}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridHierarchicalColumn.CellTemplate>
                    </DataGridHierarchicalColumn>

                    <!--
                        x2 column. Regular template columns get the HierarchicalNode as DataContext
                        (only DataGridHierarchicalColumn unwraps to the item), so bind via Item.
                    -->
                    <DataGridTemplateColumn
                        Width="*"
                        x:CompileBindings="False"
                        Header="x2">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    FontSize="10"
                                    Text="{Binding Item.X2Text}"
                                    ToolTip.Tip="{Binding Item.X2ToolTip}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!--  Status: ✓/✗ per file (source rows are blank). Bind via Item. (see x2 note).  -->
                    <DataGridTemplateColumn
                        Width="70"
                        x:CompileBindings="False"
                        Header="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel
                                    IsVisible="{Binding Item.IsPair}"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <TextBlock
                                        FontWeight="Bold"
                                        Foreground="ForestGreen"
                                        IsVisible="{Binding Item.NormalExists}"
                                        Text="&#x2713;" />
                                    <TextBlock
                                        FontWeight="Bold"
                                        Foreground="IndianRed"
                                        IsVisible="{Binding Item.NormalMissing}"
                                        Text="&#x2717;" />
                                    <TextBlock
                                        FontWeight="Bold"
                                        Foreground="ForestGreen"
                                        IsVisible="{Binding Item.X2Exists}"
                                        Text="&#x2713;" />
                                    <TextBlock
                                        FontWeight="Bold"
                                        Foreground="IndianRed"
                                        IsVisible="{Binding Item.X2Missing}"
                                        Text="&#x2717;" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!--  Status footer  -->
            <TextBlock
                Grid.Row="2"
                Margin="0,4,0,0"
                FontSize="9"
                Foreground="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}"
                Text="&#x2713; = file exists · &#x2717; = missing (resolved via mod/ then img/ then game img/)." />
        </Grid>
    </Border>
</UserControl>