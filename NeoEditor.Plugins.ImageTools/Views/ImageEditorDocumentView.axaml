<UserControl
    x:Class="NeoEditor.Plugins.ImageTools.Views.ImageEditorDocumentView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mainContent="clr-namespace:NeoEditor.Plugins.ImageTools.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:NeoEditor.Plugins.ImageTools.Views"
    d:DesignHeight="520"
    d:DesignWidth="800"
    x:DataType="mainContent:ImageEditorDocument"
    mc:Ignorable="d">
    <Grid
        MinHeight="0"
        RowDefinitions="*,Auto"
        RowSpacing="8">

        <!--  Row 0: source | result — the single-image editor pair.  -->
        <Grid
            Grid.Row="0"
            MinHeight="0"
            ColumnDefinitions="*,6,*">
            <views:ImageSlotView
                Grid.Column="0"
                MinHeight="0"
                DataContext="{Binding Source}" />
            <views:ImageSlotView
                Grid.Column="2"
                MinHeight="0"
                DataContext="{Binding Result}" />
        </Grid>

        <!--  Row 1: bottom controls — actions + pixel options | size adjustment  -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="16">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button
                    Padding="8,3"
                    Command="{Binding SelectImageCommand}"
                    Content="{Binding Loc[SelectImage]}"
                    FontSize="10" />
                <Button
                    Padding="8,3"
                    Command="{Binding ApplyCommand}"
                    Content="{Binding Loc[Pixelate]}"
                    FontSize="10"
                    IsEnabled="{Binding CanApply}" />
                <Separator
                    Width="1"
                    Margin="2,2"
                    VerticalAlignment="Stretch" />
                <TextBlock VerticalAlignment="Center" Text="{Binding ColorCountDisplay}" />
                <Slider
                    Width="110"
                    VerticalAlignment="Center"
                    IsEnabled="{Binding CanApply}"
                    LargeChange="8"
                    Maximum="{Binding MaxColorCount}"
                    Minimum="{Binding MinColorCount}"
                    TickFrequency="4"
                    Value="{Binding ColorCount, Mode=TwoWay}" />
                <CheckBox
                    VerticalAlignment="Center"
                    Content="Edges"
                    IsChecked="{Binding EdgeEnhancement, Mode=TwoWay}"
                    IsEnabled="{Binding CanApply}" />
                <CheckBox
                    VerticalAlignment="Center"
                    Content="Dither"
                    IsChecked="{Binding DitheringEnabled, Mode=TwoWay}"
                    IsEnabled="{Binding CanApply}" />
                <CheckBox
                    VerticalAlignment="Center"
                    Content="Transp. BG"
                    IsChecked="{Binding TransparentBackground, Mode=TwoWay}"
                    IsEnabled="{Binding CanApply}" />
            </StackPanel>

            <!--  Size adjustment: width / height stacked vertically  -->
            <StackPanel
                Grid.Column="1"
                Orientation="Vertical"
                Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock
                        Width="38"
                        VerticalAlignment="Center"
                        Text="{Binding Loc[Width]}" />
                    <NumericUpDown
                        Width="130"
                        FormatString="F0"
                        Increment="10"
                        Minimum="10"
                        Value="{Binding TargetWidth, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock
                        Width="38"
                        VerticalAlignment="Center"
                        Text="{Binding Loc[Height]}" />
                    <NumericUpDown
                        Width="130"
                        FormatString="F0"
                        Increment="10"
                        Minimum="10"
                        Value="{Binding TargetHeight, Mode=TwoWay}" />
                </StackPanel>
                <CheckBox Content="{Binding Loc[LockAspectRatio]}" IsChecked="{Binding LockAspectRatio, Mode=TwoWay}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
