<UserControl
    x:Class="NeoEditor.Plugins.ImageTools.Views.ImageCreateDocumentView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mainContent="clr-namespace:NeoEditor.Plugins.ImageTools.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:NeoEditor.Plugins.ImageTools.Views"
    d:DesignHeight="520"
    d:DesignWidth="900"
    x:DataType="mainContent:ImageCreateDocument"
    mc:Ignorable="d">
    <Grid
        MinHeight="0"
        ColumnDefinitions="20*,80*"
        ColumnSpacing="10">

        <!--  Left (20%): import button + pending list + open  -->
        <Grid
            Grid.Column="0"
            MinHeight="0"
            RowDefinitions="Auto,*,Auto"
            RowSpacing="8">

            <Button
                Grid.Row="0"
                Padding="10,4"
                HorizontalAlignment="Left"
                Command="{Binding ImportImagesCommand}"
                Content="{Binding Loc[ImportImages]}"
                FontSize="10" />

            <Border
                Grid.Row="1"
                MinHeight="0"
                Padding="6"
                Background="#11000000"
                BorderBrush="#22000000"
                BorderThickness="1"
                CornerRadius="4">
                <Grid MinHeight="0">
                    <ListBox
                        MinHeight="0"
                        ItemsSource="{Binding PendingItems}"
                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                        PointerPressed="OnPendingListPointerPressed">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="mainContent:PendingImageItem">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Text="{Binding DisplayName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <CheckBox
                                        Grid.Column="1"
                                        Padding="4,2"
                                        IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock
                        Margin="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Opacity="0.6"
                        IsVisible="{Binding HasNoPendingItems}"
                        Text="{Binding Loc[NoPendingItems]}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Button
                Grid.Row="2"
                Padding="10,4"
                HorizontalAlignment="Stretch"
                Command="{Binding OpenPendingCommand}"
                Content="{Binding OpenPendingButtonText}"
                FontSize="10"
                IsEnabled="{Binding CanOpenPending}" />
        </Grid>

        <!--  Right (80%): AI form (top), preview (bottom)  -->
        <Grid
            Grid.Column="1"
            MinHeight="0"
            RowDefinitions="Auto,*"
            RowSpacing="8">

            <views:AiGenerationPanelView
                Grid.Row="0"
                MinHeight="0"
                DataContext="{Binding AiPanel}" />

            <!--  Bottom: preview  -->
            <Border
                Grid.Row="1"
                MinHeight="0"
                Padding="10"
                Background="#11000000"
                BorderBrush="#22000000"
                BorderThickness="1"
                CornerRadius="4">
                <Grid
                    MinHeight="0"
                    RowDefinitions="Auto,*,Auto">
                    <TextBlock
                        Grid.Row="0"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="{Binding Loc[Preview]}" />
                    <Grid Grid.Row="1" MinHeight="0">
                        <Image
                            MinHeight="0"
                            Source="{Binding PreviewImage}"
                            Stretch="Uniform" />
                        <TextBlock
                            Margin="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="10"
                            Opacity="0.6"
                            IsVisible="{Binding HasNoPreview}"
                            Text="{Binding Loc[NoPreview]}"
                            TextWrapping="Wrap" />
                    </Grid>
                    <StackPanel
                        Grid.Row="2"
                        Margin="0,6,0,0"
                        Spacing="2">
                        <TextBlock
                            FontSize="10"
                            FontWeight="SemiBold"
                            IsVisible="{Binding HasPreview}"
                            Text="{Binding PreviewName}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="9"
                            Opacity="0.7"
                            IsVisible="{Binding HasPreview}"
                            Text="{Binding PreviewDimensions}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
