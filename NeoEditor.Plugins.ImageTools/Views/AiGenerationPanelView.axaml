<UserControl
    x:Class="NeoEditor.Plugins.ImageTools.Views.AiGenerationPanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mainContent="clr-namespace:NeoEditor.Plugins.ImageTools.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="260"
    d:DesignWidth="520"
    x:DataType="mainContent:AiGenerationPanelViewModel"
    mc:Ignorable="d">
    <Grid
        MinHeight="0"
        RowDefinitions="Auto,Auto,Auto,Auto,Auto"
        RowSpacing="8">

        <!--  Row 0: title  -->
        <TextBlock
            Grid.Row="0"
            FontSize="11"
            FontWeight="SemiBold"
            Text="{Binding Loc[AiGalleryTitle]}" />

        <!--  Row 1: prompt (stretches) + generate  -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="8">
            <TextBox
                Grid.Column="0"
                IsEnabled="{Binding IsAiAvailable}"
                PlaceholderText="{Binding Loc[AiPromptPlaceholder]}"
                Text="{Binding AiPrompt, Mode=TwoWay}" />
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Command="{Binding GenerateCommand}"
                Content="{Binding Loc[AiGenerate]}"
                IsEnabled="{Binding CanGenerate}" />
        </Grid>

        <!--  Row 2: size + count (fixed labels, wider inputs)  -->
        <Grid
            Grid.Row="2"
            ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
            ColumnSpacing="6">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="Gray"
                Text="Size:" />
            <NumericUpDown
                Grid.Column="1"
                Width="130"
                IsEnabled="{Binding IsAiAvailable}"
                Value="{Binding AiWidth}"
                Minimum="512"
                Maximum="2880"
                Increment="16" />
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Text="×" />
            <NumericUpDown
                Grid.Column="3"
                Width="130"
                IsEnabled="{Binding IsAiAvailable}"
                Value="{Binding AiHeight}"
                Minimum="512"
                Maximum="2880"
                Increment="16" />
            <TextBlock
                Grid.Column="4"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="Gray"
                Text="{Binding Loc[CandidateCount]}" />
            <NumericUpDown
                Grid.Column="5"
                Width="140"
                IsEnabled="{Binding IsAiAvailable}"
                Value="{Binding CandidateCount}"
                Minimum="{Binding MinCandidateCount}"
                Maximum="{Binding MaxCandidateCount}"
                Increment="1"
                FormatString="F0" />
        </Grid>

        <!--  Row 3: error / unavailable hint  -->
        <Grid
            Grid.Row="3"
            ColumnDefinitions="*,Auto">
            <TextBlock
                FontSize="9"
                Foreground="#E57373"
                IsVisible="{Binding HasGenerationError}"
                MaxWidth="420"
                Text="{Binding GenerationError}"
                TextWrapping="Wrap" />
            <TextBlock
                Grid.Column="1"
                FontSize="9"
                IsVisible="{Binding IsAiUnavailable}"
                Opacity="0.7"
                Text="{Binding Loc[AiUnavailableHint]}" />
        </Grid>

        <!--  Row 4: generation progress (spans the remaining space; empty when idle)  -->
        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="6"
            IsVisible="{Binding IsGenerating}">
            <ProgressBar
                Width="200"
                Height="6"
                IsIndeterminate="True" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="9"
                Opacity="0.6"
                Text="{Binding GenerationProgressText}" />
        </StackPanel>
    </Grid>
</UserControl>
