<Window
    x:Class="NeoEditor.Plugins.EntityEditor.Views.ReferencePickerDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:NeoEditor.Plugins.EntityEditor.ViewModels"
    x:DataType="vm:ReferencePickerViewModel"
    Width="650" Height="480"
    MinWidth="450" MinHeight="320"
    Title="Select Reference Target"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid Margin="12" RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <!-- Row 0: Search -->
        <TextBox Grid.Row="0"
                 Text="{Binding SearchText, Mode=TwoWay}"
                 Watermark="Filter entities..."
                 FontSize="12" Padding="6,4" />

        <!-- Row 1: Main content -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*">
            <!-- Left: Entity list -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}"
                    BorderThickness="1" Padding="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Available Entities"
                               FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" />
                    <ListBox Name="EntityListBox"
                             ItemsSource="{Binding FilteredEntities}"
                             SelectedItem="{Binding SelectedEntity, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:EntityViewModel">
                                <StackPanel Margin="2,3">
                                    <TextBlock Text="{Binding Subject}"
                                               FontSize="11" FontWeight="SemiBold"
                                               TextWrapping="NoWrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding EntityId}"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}" />
                                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                                CornerRadius="3" Padding="4,1">
                                            <TextBlock Text="{Binding ModName}"
                                                       FontSize="8" />
                                        </Border>
                                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                                CornerRadius="3" Padding="4,1">
                                            <TextBlock Text="{Binding EntityType.Name}"
                                                       FontSize="8" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Center: Action buttons (multi-value only) -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="10,0" Spacing="6"
                        Name="MultiValueActions">
                <Button Name="AddButton"
                        Content="Add →"
                        Padding="10,6" FontSize="11"
                        Click="OnAddClick" />
                <Button Name="RemoveButton"
                        Content="← Remove"
                        Padding="10,6" FontSize="11"
                        Click="OnRemoveClick" />
            </StackPanel>

            <!-- Right: Selected entries + decorations -->
            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}"
                    BorderThickness="1" Padding="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Selected"
                               FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" />
                    <Button DockPanel.Dock="Bottom"
                            Name="SingleSelectButton"
                            Content="Select Entity"
                            Padding="8,4" FontSize="11"
                            Click="OnAddClick" />
                    <ScrollViewer>
                        <ItemsControl Name="SelectedItemsControl"
                                      ItemsSource="{Binding SelectedEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ReferenceEntryViewModel">
                                    <Border Padding="4,3" Margin="0,2"
                                            BorderBrush="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}"
                                            BorderThickness="0,0,0,1">
                                        <StackPanel Spacing="4">
                                            <!-- Entry header: display name + remove button -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding DisplayText}"
                                                           FontWeight="SemiBold" FontSize="10"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="1"
                                                        Content="✕" FontSize="8" Padding="3,1"
                                                        Tag="{Binding}"
                                                        Click="OnRemoveEntryClick" />
                                            </Grid>

                                            <!-- Decoration summary -->
                                            <TextBlock Text="{Binding DecorationSummary}"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}"
                                                       Name="DecoSummary" />

                                            <!-- Multiplier editor -->
                                            <StackPanel Spacing="3"
                                                        Name="MultiplierPanel">
                                                <Grid ColumnDefinitions="60,*">
                                                    <TextBlock Grid.Column="0" Text="Multiplier:"
                                                               FontSize="9" VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="1" Text="{Binding Multiplier, Mode=TwoWay}"
                                                             FontSize="9" Padding="2,1" />
                                                </Grid>
                                            </StackPanel>

                                            <!-- Negation toggle -->
                                            <CheckBox IsChecked="{Binding IsNegated, Mode=TwoWay}"
                                                      Content="Negated (-)"
                                                      FontSize="9"
                                                      Name="NegationCheck" />

                                            <!-- Assignment editor -->
                                            <StackPanel Spacing="3"
                                                        Name="AssignPanel">
                                                <Grid ColumnDefinitions="60,*">
                                                    <TextBlock Grid.Column="0" Text="Value:"
                                                               FontSize="9" VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="1" Text="{Binding AssignedValue, Mode=TwoWay}"
                                                             FontSize="9" Padding="2,1" />
                                                </Grid>
                                                <CheckBox IsChecked="{Binding ValueFirst, Mode=TwoWay}"
                                                          Content="Value before ID"
                                                          FontSize="9" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Row 2: Preview + buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <Border Grid.Column="0"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="4" Padding="8,4">
                <TextBlock Text="{Binding PreviewRawText, StringFormat='Preview: {0}'}"
                           FontSize="10" FontFamily="Consolas"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
            </Border>
            <Button Grid.Column="1"
                    Click="OnCancelClick"
                    Content="Cancel"
                    Padding="16,6" FontSize="11" />
            <Button Grid.Column="2"
                    Click="OnConfirmClick"
                    Content="OK"
                    Padding="16,6" FontSize="11"
                    IsDefault="True" />
        </Grid>
    </Grid>
</Window>
