<UserControl
    x:Class="NeoEditor.Plugins.EntityEditor.Views.KeyValueEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="clr-namespace:NeoEditor.Plugins.EntityEditor.ViewModels"
    xmlns:views="clr-namespace:NeoEditor.Plugins.EntityEditor.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DataType="vm:KeyValueEditorViewModel"
    mc:Ignorable="d">
    <Design.DataContext>
        <vm:KeyValueEditorViewModel />
    </Design.DataContext>
    <UserControl.Resources>
        <vm:BoolStringConverter x:Key="BoolStringConverter" />
        <vm:ControlTypeVisibilityConverter x:Key="CtrlTypeVis" />
        <vm:EmptyStringToNullConverter x:Key="EmptyToNull" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="TextBox.Dirty">
            <Setter Property="BorderBrush" Value="Orange" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="TextBox.Applied">
            <Setter Property="BorderBrush" Value="#4CAF50" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- Docs/41 需求1: the "unsaved changes" banner is gone — edits auto-save now.
             Per-field "edited (not yet exported)" markers live on each row instead. -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Sections}" Name="FieldSectionsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:FieldSection">
                        <StackPanel>
                            <Border Padding="6,2"
                                    Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                                <TextBlock Text="{Binding Header}"
                                           FontSize="10" FontWeight="SemiBold" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding Fields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:FieldRow">
                                        <Border Padding="4,2"
                                                BorderBrush="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}"
                                                BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="14,100,*" Margin="0,2">
                                                <!-- Docs/41 P4: visible '?' affordance — hover for the
                                                     field meaning (embedded Docs/38 description). -->
                                                <TextBlock Grid.Column="0"
                                                           Text="?"
                                                           FontSize="10"
                                                           Foreground="Gray"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,0,3,0"
                                                           IsVisible="{Binding HasDescription}"
                                                           ToolTip.Tip="{Binding Description, Converter={StaticResource EmptyToNull}}"
                                                           ToolTip.ShowDelay="300" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               VerticalAlignment="Center"
                                                               FontSize="10"
                                                               TextWrapping="NoWrap"
                                                               ToolTip.Tip="{Binding Description, Converter={StaticResource EmptyToNull}}"
                                                               ToolTip.ShowDelay="300" />
                                                    <!-- Docs/41 需求1: per-field "edited, not yet exported"
                                                         marker (yellow dot) — survives auto-save, cleared
                                                         only by Save & Export. -->
                                                    <TextBlock Text="●"
                                                               FontSize="8"
                                                               Foreground="#E6A700"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding IsEdited}"
                                                               ToolTip.Tip="已修改，尚未导出（Save &amp; Export 后清除）"
                                                               ToolTip.ShowDelay="300" />
                                                </StackPanel>
                                                <!-- ReadOnly: TextBlock (primary key + metadata) -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding CurrentValue}"
                                                           IsVisible="{Binding IsReadOnly}"
                                                           VerticalAlignment="Center"
                                                           FontSize="10"
                                                           TextWrapping="Wrap" />
                                                <!-- CheckBox for bool -->
                                                <CheckBox Grid.Column="2"
                                                           IsChecked="{Binding CurrentValue, Converter={StaticResource BoolStringConverter}, Mode=TwoWay}"
                                                           IsVisible="{Binding ControlType, Converter={StaticResource CtrlTypeVis}, ConverterParameter=toggle}"
                                                           VerticalAlignment="Center"
                                                           LostFocus="OnValueBoxLostFocus" />
                                                <!-- ComboBox for enums -->
                                                <ComboBox Grid.Column="2"
                                                          SelectedItem="{Binding CurrentValue, Mode=TwoWay}"
                                                          ItemsSource="{Binding EnumValues}"
                                                          IsVisible="{Binding ControlType, Converter={StaticResource CtrlTypeVis}, ConverterParameter=combo}"
                                                          FontSize="10"
                                                          LostFocus="OnValueBoxLostFocus" />
                                                <!-- Default TextBox (string, numeric) -->
                                                <TextBox Grid.Column="2"
                                                         Text="{Binding CurrentValue, Mode=TwoWay}"
                                                         IsVisible="{Binding ControlType, Converter={StaticResource CtrlTypeVis}, ConverterParameter=textbox}"
                                                         IsReadOnly="{Binding IsReadOnly}"
                                                         FontSize="10"
                                                         Padding="4,2"
                                                         Classes.Dirty="{Binding IsDirty}"
                                                         Classes.Applied="{Binding IsJustApplied}"
                                                         Name="ValueBox"
                                                         LostFocus="OnValueBoxLostFocus"
                                                         KeyDown="OnValueBoxKeyDown" />
                                                <!-- Reference picker control -->
                                                <views:ReferenceFieldEditor Grid.Column="2"
                                                         IsVisible="{Binding ControlType, Converter={StaticResource CtrlTypeVis}, ConverterParameter=refpicker}"
                                                         VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
