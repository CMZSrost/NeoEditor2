<Window
    x:Class="NeoEditor.Player.Views.LogOverlayWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:NeoEditor.Player.ViewModels"
    xmlns:loc="clr-namespace:NeoEditor.Player.Services"
    xmlns:log="clr-namespace:NeoEditor.Player.Core.Logging;assembly=NeoEditor.Player.Core"
    x:Name="Root"
    x:DataType="vm:PlayerViewModel"
    Title="{Binding [Log.OverlayTitle], Source={x:Static loc:LocalizationManager.Instance}}"
    ShowInTaskbar="False"
    Width="900"
    Height="620"
    WindowStartupLocation="CenterOwner">

    <DockPanel>
        <!--  R52: 顶栏两行——第一行标题+日志路径，第二行级别过滤+操作按钮；
             全部颜色跟随主题（DynamicResource，不再固定深色）  -->
        <Border
            DockPanel.Dock="Top"
            Padding="10,6"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                        Text="{Binding [Log.OverlayTitle], Source={x:Static loc:LocalizationManager.Instance}}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                        <Run Text="{Binding [Log.FilePrefix], Source={x:Static loc:LocalizationManager.Instance}}" />
                        <Run Text="{Binding FileLogDirectory}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{Binding [Log.Level], Source={x:Static loc:LocalizationManager.Instance}}"
                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    <ComboBox
                        Width="120"
                        ItemsSource="{x:Static vm:PlayerViewModel.LevelFilters}"
                        SelectedItem="{Binding LevelFilter}" />
                    <Button
                        Content="{Binding [Log.OpenFolder], Source={x:Static loc:LocalizationManager.Instance}}"
                        Click="OnOpenLogFolderClick" />
                    <Button
                        Content="{Binding [Log.Clipboard], Source={x:Static loc:LocalizationManager.Instance}}"
                        Click="OnClipboardCheckClick" />
                    <Button
                        Content="{Binding [Log.Export], Source={x:Static loc:LocalizationManager.Instance}}"
                        Click="OnExportLogsClick" />
                    <Button
                        Content="{Binding [Log.Clear], Source={x:Static loc:LocalizationManager.Instance}}"
                        Click="OnClearLogsClick" />
                    <Button
                        Content="{Binding [Log.Close], Source={x:Static loc:LocalizationManager.Instance}}"
                        Click="OnCloseClick" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  R53: 非虚拟化（StackPanel ItemsPanel）——Expander 展开行高变化时滚动条不再
             跳来跳去；行数受控（剪贴板截获是大块行），渲染开销可接受  -->
        <ListBox
            Margin="8,4"
            ItemsSource="{Binding VisibleLines}"
            Background="Transparent"
            FontFamily="Consolas, Sarasa Mono SC, monospace"
            FontSize="12">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="log:PlayerLogLine">
                    <!--  v2.29: 摘要行固定高度防滚动跳动；R49: Expander 点开展开完整内容；
                          R52: 颜色跟随主题；R53: 去虚拟化 + 紧凑  -->
                    <Expander HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8" Height="20">
                                <TextBlock
                                    Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                                    FontSize="11"
                                    Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <TextBlock
                                    Text="{Binding Level}"
                                    FontSize="11"
                                    Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                                    Width="72" />
                                <TextBlock
                                    Text="{Binding Message}"
                                    FontSize="11"
                                    Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip.Tip="{Binding Message}" />
                            </StackPanel>
                        </Expander.Header>
                        <TextBlock
                            Text="{Binding Message}"
                            Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                            TextWrapping="Wrap"
                            FontSize="11"
                            Margin="20,2,4,6" />
                    </Expander>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
