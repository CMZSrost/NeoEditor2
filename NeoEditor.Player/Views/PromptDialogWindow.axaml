<Window
    x:Class="NeoEditor.Player.Views.PromptDialogWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Prompt"
    Width="380"
    SizeToContent="Height"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <!--  Two-in-one prompt (v2.41): Confirm mode (message only) or Input mode
          (named manual backups). OK returns the text (or "ok"); Cancel returns null.  -->
    <StackPanel Margin="16,14">
        <TextBlock
            x:Name="MessageText"
            TextWrapping="Wrap"
            FontSize="12"
            IsVisible="False" />
        <TextBox
            x:Name="InputBox"
            Margin="0,10,0,0"
            FontSize="12"
            IsVisible="False"
            KeyDown="OnInputKeyDown" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button
                x:Name="OkButton"
                MinWidth="72"
                Click="OnOkClick"
                Background="#E8E8E8"
                Foreground="Black" />
            <Button
                x:Name="CancelButton"
                MinWidth="72"
                Content="Cancel"
                Click="OnCancelClick"
                Background="#E8E8E8"
                Foreground="Black" />
        </StackPanel>
    </StackPanel>
</Window>
