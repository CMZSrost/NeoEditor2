<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
        <RootNamespace>NeoEditor.Plugins.AiChat</RootNamespace>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <NoWarn>CS8618;CS9264</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\NeoEditor.Core\NeoEditor.Core.csproj" />
        <ProjectReference Include="..\NeoEditor.Infra\NeoEditor.Infra.csproj" />
        <ProjectReference Include="..\NeoEditor.UI.Common\NeoEditor.UI.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="NeoEditor.Infra.Services" />
        <Using Include="NeoEditor.UI.Common.Services" />
        <Using Include="NeoEditor.UI.Common.Visualizers" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.1" />
        <PackageReference Include="ProDataGrid" Version="12.0.4" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference Include="CommunityToolkit.VectorData.InMemory" Version="1.0.0-preview.3" />
        <PackageReference Include="FluentIcons.Avalonia" Version="2.1.333" />
        <PackageReference Include="Microsoft.Extensions.AI" Version="10.5.2" />
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.5.2" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    </ItemGroup>

</Project>
