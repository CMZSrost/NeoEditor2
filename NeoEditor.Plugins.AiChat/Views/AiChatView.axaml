<UserControl
    x:Class="NeoEditor.Plugins.AiChat.Views.AiChatView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lm="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
    xmlns:vm="clr-namespace:NeoEditor.Plugins.AiChat.ViewModels;assembly=NeoEditor.Plugins.AiChat"
    x:DataType="vm:AiChatViewModel">
    <UserControl.Resources>
        <!--  Bubble / block brushes — fixed colors so they read the same on light and dark  -->
        <SolidColorBrush x:Key="UserBubbleBrush" Color="#40478FD9" />
        <SolidColorBrush x:Key="AssistantBubbleBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="AssistantBorderBrush" Color="#66808080" />
        <SolidColorBrush x:Key="ToolBlockBrush" Color="#FF2D2D30" />
        <SolidColorBrush x:Key="ToolBlockTextBrush" Color="#FFE8E8E8" />
        <SolidColorBrush x:Key="SystemStripBrush" Color="#1A808080" />
    </UserControl.Resources>

    <!--  Grid rows so the history gets the * fill and the input stays compact (task 6).
          The previous DockPanel let the last child (input) fill and squeezed the history.  -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="8">
        <!--  Header  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,8"
            Orientation="Horizontal"
            Spacing="8">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Bold"
                Text="AI Chat" />
            <Button
                Command="{Binding ClearMessagesCommand}"
                Content="Clear"
                IsEnabled="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}" />
            <Button
                Command="{Binding ToggleSystemPromptCommand}"
                Content="System Prompt"
                IsEnabled="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}" />
            <!--  RAG controls  -->
            <Button
                Command="{Binding BuildIndexCommand}"
                Content="Build Index"
                IsEnabled="{Binding CanBuildIndex}"
                ToolTip.Tip="Build search index from all game entities for smarter AI responses" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                Text="{Binding RagStatus}" />
        </StackPanel>

        <!--  Not-configured notice (visible when no API key)  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,8"
            Padding="8"
            BorderBrush="Orange"
            BorderThickness="1"
            CornerRadius="4"
            IsVisible="{Binding IsAvailable, Converter={x:Static BoolConverters.Not}}">
            <TextBlock
                FontSize="11"
                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                TextWrapping="Wrap"
                Text="⚠️ AI Chat is not configured. Set an API Key in Settings → AI &amp; MCP, then restart the app." />
        </Border>

        <!--  System Prompt Panel (collapsible)  -->
        <Border
            Grid.Row="2"
            Margin="0,0,0,8"
            Padding="8"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
            BorderThickness="1"
            CornerRadius="4"
            IsVisible="{Binding IsSystemPromptExpanded}">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="System Prompt" />
                    <Button
                        Command="{Binding ApplySystemPromptCommand}"
                        Content="Apply"
                        IsEnabled="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}" />
                    <Button
                        Command="{Binding ResetSystemPromptCommand}"
                        Content="Reset to Default"
                        IsEnabled="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}" />
                </StackPanel>
                <TextBox
                    MinHeight="100"
                    MaxHeight="300"
                    AcceptsReturn="True"
                    FontFamily="Cascadia Code, Consolas, monospace"
                    FontSize="11"
                    IsEnabled="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}"
                    Text="{Binding SystemPrompt}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!--  Chat history — ItemsControl with a per-Kind bubble/block template (round22).
              One template; exactly one Border is visible depending on the message Kind.  -->
        <ScrollViewer
            x:Name="MessageScroll"
            Grid.Row="3"
            Margin="0,0,0,8">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.DataTemplates>
                    <DataTemplate x:DataType="vm:ChatMessageItem">
                        <Grid>
                            <!--  Tool invocation block: expandable — header shows the tool name,
                                  content shows the tool result (click to expand).  -->
                            <Expander
                                Margin="0,4"
                                Padding="8,2,8,4"
                                CornerRadius="6"
                                Background="{StaticResource ToolBlockBrush}"
                                Foreground="{StaticResource ToolBlockTextBrush}"
                                HorizontalAlignment="Stretch"
                                IsVisible="{Binding IsTool}">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="&#x2699;" />
                                        <SelectableTextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="Cascadia Code, Consolas, monospace"
                                            FontSize="11"
                                            Text="{Binding ToolName}" />
                                    </StackPanel>
                                </Expander.Header>
                                <SelectableTextBlock
                                    Margin="4,2,0,4"
                                    FontFamily="Cascadia Code, Consolas, monospace"
                                    FontSize="10"
                                    Text="{Binding Content}"
                                    TextWrapping="Wrap" />
                            </Expander>

                            <!--  System notice: centered neutral strip  -->
                            <Border
                                Margin="0,4"
                                Padding="10,4"
                                CornerRadius="6"
                                Background="{StaticResource SystemStripBrush}"
                                HorizontalAlignment="Center"
                                IsVisible="{Binding IsSystem}">
                                <SelectableTextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                    Text="{Binding Content}"
                                    TextWrapping="Wrap" />
                            </Border>

                            <!--  User bubble: right-aligned blue  -->
                            <Border
                                MaxWidth="480"
                                Margin="0,4"
                                Padding="10,6"
                                CornerRadius="8"
                                Background="{StaticResource UserBubbleBrush}"
                                HorizontalAlignment="Right"
                                IsVisible="{Binding IsUser}">
                                <SelectableTextBlock
                                    Text="{Binding Content}"
                                    TextWrapping="Wrap" />
                            </Border>

                            <!--  Assistant bubble: left-aligned with a visible border  -->
                            <Border
                                MaxWidth="480"
                                Margin="0,4"
                                Padding="10,6"
                                CornerRadius="8"
                                Background="{StaticResource AssistantBubbleBrush}"
                                BorderBrush="{StaticResource AssistantBorderBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Left"
                                IsVisible="{Binding IsAssistant}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock
                                            FontSize="9"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                            Text="AI" />
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="Gray"
                                            IsVisible="{Binding IsThinking}"
                                            Text="…" />
                                        <!-- Docs/41: copy the generated content -->
                                        <Button
                                            Margin="8,0,0,0"
                                            Padding="4,0"
                                            FontSize="9"
                                            Command="{Binding CopyCommand}"
                                            ToolTip.Tip="Copy">
                                            <TextBlock Text="📋" FontSize="10" />
                                        </Button>
                                    </StackPanel>
                                    <!-- Docs/41: AI output renders as Markdown by default -->
                                    <lm:MarkdownRenderer
                                        Margin="0,2,0,0"
                                        CodeBlockColorTheme="DarkPlus"
                                        MarkdownBuilder="{Binding MarkdownBuilder}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>

        <!--  Input  -->
        <Border
            Grid.Row="4"
            Padding="4"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox
                    Grid.Column="0"
                    AcceptsReturn="False"
                    IsEnabled="{Binding CanSend}"
                    Text="{Binding InputText}"
                    PlaceholderText="Type a message...">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SendMessageCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Button
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="16,4"
                    Command="{Binding SendOrStopCommand}"
                    Content="{Binding SendOrStopLabel}"
                    IsEnabled="{Binding IsAvailable}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
