<UserControl
    x:Class="NeoEditor.Plugins.AiChat.Views.AiChatView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:NeoEditor.Plugins.AiChat.Converters"
    xmlns:vm="clr-namespace:NeoEditor.Plugins.AiChat.ViewModels;assembly=NeoEditor.Plugins.AiChat"
    x:DataType="vm:AiChatViewModel">
    <UserControl.Resources>
        <conv:BoolToHorizontalAlignmentConverter x:Key="UserAlignment" />
        <conv:BoolToBubbleBrushConverter x:Key="BubbleBrush" />
    </UserControl.Resources>

    <!--  Grid rows so the history gets the * fill and the input stays compact (task 6).
          The previous DockPanel let the last child (input) fill and squeezed the history.  -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="8">
        <!--  Header  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,8"
            Orientation="Horizontal"
            Spacing="8">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Bold"
                Text="AI Chat" />
            <Button
                Command="{Binding ClearMessagesCommand}"
                Content="Clear"
                IsEnabled="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}" />
            <Button
                Command="{Binding ToggleSystemPromptCommand}"
                Content="System Prompt"
                IsEnabled="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}" />
            <!--  RAG controls  -->
            <Button
                Command="{Binding BuildIndexCommand}"
                Content="Build Index"
                IsEnabled="{Binding CanBuildIndex}"
                ToolTip.Tip="Build search index from all game entities for smarter AI responses" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                Text="{Binding RagStatus}" />
        </StackPanel>

        <!--  Not-configured notice (visible when no API key)  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,8"
            Padding="8"
            BorderBrush="Orange"
            BorderThickness="1"
            CornerRadius="4"
            IsVisible="{Binding IsAvailable, Converter={x:Static BoolConverters.Not}}">
            <TextBlock
                FontSize="11"
                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                TextWrapping="Wrap"
                Text="⚠️ AI Chat is not configured. Set an API Key in Settings → AI &amp; MCP, then restart the app." />
        </Border>

        <!--  System Prompt Panel (collapsible)  -->
        <Border
            Grid.Row="2"
            Margin="0,0,0,8"
            Padding="8"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
            BorderThickness="1"
            CornerRadius="4"
            IsVisible="{Binding IsSystemPromptExpanded}">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="System Prompt" />
                    <Button
                        Command="{Binding ApplySystemPromptCommand}"
                        Content="Apply"
                        IsEnabled="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}" />
                    <Button
                        Command="{Binding ResetSystemPromptCommand}"
                        Content="Reset to Default"
                        IsEnabled="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}" />
                </StackPanel>
                <TextBox
                    MinHeight="100"
                    MaxHeight="300"
                    AcceptsReturn="True"
                    FontFamily="Cascadia Code, Consolas, monospace"
                    FontSize="11"
                    IsEnabled="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}"
                    Text="{Binding SystemPrompt}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!--  Chat history — single-column DataGrid, ChatMimic bubbles (task 6)  -->
        <DataGrid
            x:Name="MessageGrid"
            Grid.Row="3"
            Margin="0,0,0,8"
            ItemsSource="{Binding Messages}"
            AutoGenerateColumns="False"
            HeadersVisibility="None"
            GridLinesVisibility="None"
            IsReadOnly="True"
            UseLogicalScrollable="True"
            CanUserSortColumns="False"
            CanUserResizeColumns="False"
            CanUserReorderColumns="False">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ChatMessageItem">
                            <Border
                                MaxWidth="480"
                                Margin="0,4"
                                Padding="10,6"
                                CornerRadius="8"
                                HorizontalAlignment="{Binding IsUser, Converter={StaticResource UserAlignment}}"
                                Background="{Binding IsUser, Converter={StaticResource BubbleBrush}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Text="{Binding Role}" />
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="Gray"
                                            IsVisible="{Binding IsThinking}"
                                            Text="…" />
                                    </StackPanel>
                                    <SelectableTextBlock
                                        Margin="0,2,0,0"
                                        Text="{Binding Content}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!--  Input  -->
        <Border
            Grid.Row="4"
            Padding="4"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox
                    Grid.Column="0"
                    AcceptsReturn="False"
                    IsEnabled="{Binding CanSend}"
                    Text="{Binding InputText}"
                    Watermark="Type a message..." />
                <Button
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="16,4"
                    Command="{Binding SendMessageCommand}"
                    Content="Send"
                    IsEnabled="{Binding CanSend}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
