<UserControl
    x:Class="NeoEditor.Views.UserControls.ProfileToolView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:NeoEditor.ViewModels.MainContent"
    d:DesignHeight="420"
    d:DesignWidth="280"
    x:DataType="vm:ProfileToolViewModel"
    mc:Ignorable="d">
    <DockPanel Margin="4">
        <!--  Single-row icon toolbar — text lives in tooltips (task 5)  -->
        <StackPanel
            Margin="2,2,2,6"
            Orientation="Horizontal"
            Spacing="2"
            DockPanel.Dock="Top">
            <Button Command="{Binding NewModCommand}" ToolTip.Tip="New Mod">
                <avalonia:SymbolIcon FontSize="14" Symbol="AddCircle" />
            </Button>
            <Button Command="{Binding ImportModCommand}" ToolTip.Tip="Import Mod">
                <avalonia:SymbolIcon FontSize="14" Symbol="ArrowCircleDownRight" />
            </Button>
            <Separator Width="1" Margin="4,2" VerticalAlignment="Stretch" />
            <Button
                Command="{Binding EditProfileCommand}"
                IsEnabled="{Binding HasActiveProfile}"
                ToolTip.Tip="Edit Profile">
                <avalonia:SymbolIcon FontSize="14" Symbol="Edit" />
            </Button>
            <Button
                Command="{Binding ReloadMergeViewCommand}"
                IsEnabled="{Binding HasActiveProfile}"
                ToolTip.Tip="Reload Merge View">
                <avalonia:SymbolIcon FontSize="14" Symbol="ArrowClockwise" />
            </Button>
        </StackPanel>

        <!--  Active profile: Mod → XML → non-empty data class  -->
        <TreeView x:Name="ModTree" ItemsSource="{Binding ModNodes}">
            <TreeView.DataTemplates>
                <TreeDataTemplate x:DataType="vm:ProfileModNode" ItemsSource="{Binding XmlNodes}">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                </TreeDataTemplate>
                <TreeDataTemplate x:DataType="vm:ProfileXmlNode" ItemsSource="{Binding TypeNodes}">
                    <TextBlock FontSize="11" Text="{Binding Name}" />
                </TreeDataTemplate>
                <TreeDataTemplate x:DataType="vm:ProfileDataTypeNode">
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        Text="{Binding DisplayName}" />
                </TreeDataTemplate>
            </TreeView.DataTemplates>
            <TreeView.Styles>
                <Style Selector="TreeViewItem">
                    <Setter Property="(Interaction.Behaviors)">
                        <BehaviorCollectionTemplate>
                            <BehaviorCollection>
                                <EventTriggerBehavior EventName="Expanded">
                                    <InvokeCommandAction
                                        Command="{Binding ((vm:ProfileToolViewModel)DataContext).LoadXmlTypesCommand, ElementName=ModTree}"
                                        CommandParameter="{Binding}" />
                                </EventTriggerBehavior>
                            </BehaviorCollection>
                        </BehaviorCollectionTemplate>
                    </Setter>
                </Style>
            </TreeView.Styles>
        </TreeView>
    </DockPanel>
</UserControl>
