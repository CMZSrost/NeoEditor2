<UserControl
    x:Class="NeoEditor.Views.UserControls.ProfileToolView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:NeoEditor.ViewModels.MainContent"
    d:DesignHeight="420"
    d:DesignWidth="280"
    x:DataType="vm:ProfileToolViewModel"
    mc:Ignorable="d">
    <DockPanel Margin="4">
        <!--  Single-row icon toolbar — text lives in tooltips (task 5)  -->
        <StackPanel
            Margin="2,2,2,6"
            Orientation="Horizontal"
            Spacing="2"
            DockPanel.Dock="Top">
            <Button Command="{Binding NewModCommand}" ToolTip.Tip="New Mod">
                <avalonia:SymbolIcon FontSize="14" Symbol="AddCircle" />
            </Button>
            <Button Command="{Binding ImportModCommand}" ToolTip.Tip="Import Mod">
                <avalonia:SymbolIcon FontSize="14" Symbol="ArrowCircleDownRight" />
            </Button>
            <Separator Width="1" Margin="4,2" VerticalAlignment="Stretch" />
            <Button
                Command="{Binding EditProfileCommand}"
                IsEnabled="{Binding HasActiveProfile}"
                ToolTip.Tip="Edit Profile">
                <avalonia:SymbolIcon FontSize="14" Symbol="Edit" />
            </Button>
            <Button
                Command="{Binding ReloadMergeViewCommand}"
                IsEnabled="{Binding HasActiveProfile}"
                ToolTip.Tip="Reload Merge View">
                <avalonia:SymbolIcon FontSize="14" Symbol="ArrowClockwise" />
            </Button>
        </StackPanel>

        <!--  Active profile: Mod → XML → non-empty data class (ProDataGrid hierarchical grid, round22).
              Roots + lazy leaves come from the HierarchicalModel; double-click opens an XML doc.  -->
        <DataGrid
            x:Name="ModTreeGrid"
            AutoGenerateColumns="False"
            Classes="hierarchical"
            GridLinesVisibility="None"
            HeadersVisibility="None"
            HierarchicalModel="{Binding TreeModel}"
            HierarchicalRowsEnabled="True"
            IsReadOnly="True"
            CanUserReorderColumns="False"
            CanUserResizeColumns="False"
            CanUserSortColumns="False"
            DoubleTapped="OnDataGridDoubleTapped"
            SelectedItem="{Binding SelectedRow}">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open in Explorer" Command="{Binding OpenDirectoryCommand}" />
                    <MenuItem Header="Open file" Command="{Binding OpenFileCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridHierarchicalColumn
                    Width="*"
                    x:CompileBindings="False"
                    Binding="{Binding Item}">
                    <DataGridHierarchicalColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ProfileTreeItem">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Text="{Binding Icon}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Text="{Binding DisplayName}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridHierarchicalColumn.CellTemplate>
                </DataGridHierarchicalColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
