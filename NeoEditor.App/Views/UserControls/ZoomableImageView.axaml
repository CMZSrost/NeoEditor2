<UserControl
    x:Class="NeoEditor.Views.UserControls.ZoomableImageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Border Background="Transparent">
        <ScrollViewer x:Name="Host" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Image x:Name="Image" Stretch="None" />
        </ScrollViewer>
    </Border>
</UserControl>
