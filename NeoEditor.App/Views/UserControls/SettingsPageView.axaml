<UserControl
    x:Class="NeoEditor.Views.UserControls.SettingsPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:explorerPane="clr-namespace:NeoEditor.ViewModels.ExplorerPane"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:NeoEditor.ViewModels"
    x:DataType="vm:SettingsPageViewModel"
    mc:Ignorable="d">
    <Design.DataContext>
        <vm:SettingsPageViewModel />
    </Design.DataContext>

    <DockPanel>
        <!-- Top bar with back button -->
        <Border
            DockPanel.Dock="Top"
            Padding="12,8"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}"
            BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding GoBackCommand}" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <avalonia:SymbolIcon FontSize="14" Symbol="ArrowLeft" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding Loc[Back]}" />
                    </StackPanel>
                </Button>
                <TextBlock FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                           Text="{Binding Loc[Settings]}" />
            </StackPanel>
        </Border>

        <!-- Settings content: reuse the existing SettingsPane data template -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Margin="12" MaxWidth="640">
                <TextBlock FontWeight="Bold" FontSize="16" Text="{Binding Loc[Settings]}" />
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Loc[GameRootDir]}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding SettingsPane.BrowseGameDirCommand}" Content="..." Width="36" />
                        <TextBox Text="{Binding SettingsPane.DisplayGameRootDir}" Watermark="Select game root directory..." />
                    </DockPanel>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Loc[Language]}" />
                    <ComboBox ItemsSource="{Binding SettingsPane.AvailableLanguages}" SelectedItem="{Binding SettingsPane.DisplayLanguage}" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Loc[Theme]}" />
                    <ComboBox ItemsSource="{Binding SettingsPane.AvailableThemes}" SelectedItem="{Binding SettingsPane.DisplayTheme}" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Loc[FontSize]}" />
                    <NumericUpDown Value="{Binding SettingsPane.DisplayFontSize}" Minimum="8" Maximum="24" Increment="1" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Loc[AutoSaveInterval]}" />
                    <NumericUpDown Value="{Binding SettingsPane.DisplayAutoSaveInterval}" Minimum="0" Maximum="3600" Increment="30" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Loc[DefaultExportFormat]}" />
                    <ComboBox ItemsSource="{Binding SettingsPane.AvailableExportFormats}" SelectedItem="{Binding SettingsPane.DisplayDefaultExportFormat}" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Loc[GridRowHeight]}" />
                    <NumericUpDown Value="{Binding SettingsPane.DisplayGridRowHeight}" Minimum="0" Maximum="80" Increment="2" />
                </StackPanel>

                <!-- AI & MCP (Phase 9D R28 + provider list) -->
                <Border Height="1" Margin="0,8" Background="{DynamicResource SystemControlForegroundChromeDisabledLowBrush}" />
                <StackPanel Spacing="2">
                    <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding Loc[Settings.AiMcp]}" />
                    <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                               Text="{Binding Loc[Settings.AiConfigNote]}" />
                </StackPanel>

                <!-- Provider list editor -->
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Loc[Settings.Providers]}" />
                    <ItemsControl ItemsSource="{Binding SettingsPane.DisplayAiProviders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="explorerPane:AiProviderRowViewModel">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                    <StackPanel Spacing="2">
                                        <TextBox Text="{Binding Name}" Watermark="Name" />
                                        <TextBox Text="{Binding Endpoint}" Watermark="https://api.openai.com/v1" />
                                        <TextBox Text="{Binding ApiKey}" PasswordChar="•" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Top"
                                            Background="Transparent"
                                            Command="{Binding RemoveCommand}"
                                            ToolTip.Tip="{Binding RemoveToolTip}">
                                        <avalonia:SymbolIcon FontSize="14" Symbol="Dismiss" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button HorizontalAlignment="Left" Content="{Binding Loc[Settings.AddProvider]}"
                            Command="{Binding SettingsPane.AddProviderCommand}" />
                </StackPanel>

                <!-- Chat model + provider -->
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Loc[Settings.AiModel]}" />
                    <TextBlock FontSize="11" Foreground="Gray" Text="{Binding Loc[Settings.ChatProvider]}" />
                    <ComboBox ItemsSource="{Binding SettingsPane.ProviderChoices}"
                              SelectedItem="{Binding SettingsPane.SelectedChatProvider}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="explorerPane:AiProviderRowViewModel">
                                <TextBlock Text="{Binding DisplayLabel}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Text="{Binding SettingsPane.DisplayAiModel}" Watermark="gpt-4o" />
                </StackPanel>
                <!-- Embedding model + provider -->
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Loc[Settings.AiEmbeddingModel]}" />
                    <TextBlock FontSize="11" Foreground="Gray" Text="{Binding Loc[Settings.EmbeddingProvider]}" />
                    <ComboBox ItemsSource="{Binding SettingsPane.ProviderChoices}"
                              SelectedItem="{Binding SettingsPane.SelectedEmbeddingProvider}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="explorerPane:AiProviderRowViewModel">
                                <TextBlock Text="{Binding DisplayLabel}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Text="{Binding SettingsPane.DisplayAiEmbeddingModel}" Watermark="text-embedding-3-small" />
                </StackPanel>
                <!-- Image model + provider -->
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Loc[Settings.ImageModel]}" />
                    <TextBlock FontSize="11" Foreground="Gray" Text="{Binding Loc[Settings.ImageProvider]}" />
                    <ComboBox ItemsSource="{Binding SettingsPane.ProviderChoices}"
                              SelectedItem="{Binding SettingsPane.SelectedImageProvider}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="explorerPane:AiProviderRowViewModel">
                                <TextBlock Text="{Binding DisplayLabel}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Text="{Binding SettingsPane.DisplayImageModel}" Watermark="dall-e-3" />
                </StackPanel>
                <!-- Image model connectivity test -->
                <StackPanel Spacing="4">
                    <Button HorizontalAlignment="Left" Content="{Binding Loc[Settings.TestImageConnection]}"
                            Command="{Binding SettingsPane.TestImageConnectionCommand}"
                            IsEnabled="{Binding !SettingsPane.IsTestingImageConnection}" />
                    <TextBlock IsVisible="{Binding SettingsPane.IsTestingImageConnection}"
                               FontSize="11" Foreground="Gray" Text="{Binding Loc[Settings.TestingImageConnection]}" />
                    <TextBlock IsVisible="{Binding SettingsPane.HasImageTestResult}"
                               FontSize="11" TextWrapping="Wrap" Foreground="Gray"
                               Text="{Binding SettingsPane.ImageTestResult}" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <CheckBox Content="{Binding Loc[Settings.McpEnabled]}" IsChecked="{Binding SettingsPane.DisplayMcpEnabled}" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Loc[Settings.McpPort]}" />
                    <NumericUpDown Value="{Binding SettingsPane.DisplayMcpPort}" Minimum="0" Maximum="65535" Increment="1" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Loc[Settings.MaxToolCalls]}" />
                    <TextBlock FontSize="11" Foreground="Gray" Text="{Binding Loc[Settings.MaxToolCallsNote]}" />
                    <NumericUpDown Value="{Binding SettingsPane.DisplayMaxToolCalls}" Minimum="1" Maximum="200" Increment="1" />
                </StackPanel>

                <!-- Column Visibility -->
                <Expander Header="Column Visibility" IsExpanded="False" Margin="0,8,0,0">
                    <ScrollViewer MaxHeight="400" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SettingsPane.TableColumns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding TableName}" IsExpanded="False" Margin="0,2">
                                        <StackPanel Margin="8,4,0,4">
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                                                <Button Content="All" FontSize="10" Padding="6,2"
                                                        Command="{Binding SelectAllCommand}" />
                                                <Button Content="None" FontSize="10" Padding="6,2"
                                                        Command="{Binding SelectNoneCommand}" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Columns}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsVisible}"
                                                                  Content="{Binding DisplayName}"
                                                                  Margin="0,1" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
