<UserControl
    x:Class="NeoEditor.Views.UserControls.SoundsToolView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    x:DataType="vm:SoundsToolViewModel"
    xmlns:vm="using:NeoEditor.ViewModels.ExplorerPane"
    d:DesignHeight="400"
    d:DesignWidth="280"
    mc:Ignorable="d">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="8,8,8,4">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBox
                    MinHeight="24"
                    Watermark="搜索 cue 名…"
                    Text="{Binding Filter}" />
                <Button MinHeight="24" Padding="8,2" Command="{Binding RefreshCommand}">↻</Button>
            </StackPanel>
            <TextBlock
                FontSize="10"
                Foreground="#888"
                Text="{Binding Status}" />
        </StackPanel>

        <ListBox
            x:Name="SoundList"
            Margin="8,4,8,8"
            ItemsSource="{Binding Sounds}"
            SelectionChanged="OnSelectionChanged">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="6,3" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="FontSize" Value="11" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            Grid.Column="0"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="1"
                            FontSize="9"
                            Foreground="#999"
                            Text="{Binding SizeText}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
