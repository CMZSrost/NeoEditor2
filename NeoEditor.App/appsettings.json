{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Extensions.Localization": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DetailedErrors": true,
  "CultureSettings": {
    "DefaultCulture": {
      "Code": "zh",
      "Name": "简体中文"
    },
    "Cultures": [
      {
        "Code": "zh",
        "Name": "简体中文"
      },
      {
        "Code": "en-us",
        "Name": "English"
      }
    ]
  }
}
